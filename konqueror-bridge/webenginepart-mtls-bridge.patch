+// The RefineID card bridge: konqueror-bridge in refineid-hack.
+QByteArray bridgeFile(const char *name)
+{
+    QFile file(QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation)
+               + QStringLiteral("/refineid/bridge/") + QLatin1String(name));
+    return file.open(QIODevice::ReadOnly) ? file.readAll().trimmed() : QByteArray();
+}
+
+// Runs when the plugin loads, before QtWebEngine reads its flags.
+void trustBridgeKey()
+{
+    const QByteArray pin = bridgeFile("spki-sha256.base64");
+    if (!pin.isEmpty()) {
+        QByteArray flags = qgetenv("QTWEBENGINE_CHROMIUM_FLAGS");
+        flags.append(" --ignore-certificate-errors-spki-list=").append(pin);
+        qputenv("QTWEBENGINE_CHROMIUM_FLAGS", flags);
+    }
+}
+Q_CONSTRUCTOR_FUNCTION(trustBridgeKey)
+
+void useBridgeIfRunning()
+{
+    const QByteArray secret = bridgeFile("proxy-secret");
+    QTcpSocket probe;
+    probe.connectToHost(QHostAddress::LocalHost, 18443);
+    if (!secret.isEmpty() && probe.waitForConnected(50)) {
+        QNetworkProxy::setApplicationProxy(QNetworkProxy(QNetworkProxy::HttpProxy, QStringLiteral("127.0.0.1"), 18443,
+                                                         QStringLiteral("refineid"), QString::fromLatin1(secret)));
+    }
+}
 
+}
