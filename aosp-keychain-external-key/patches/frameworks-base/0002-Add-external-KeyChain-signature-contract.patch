+++ b/keystore/java/android/security/KeyChainExternalSignatureRequest.java
@@ -0,0 +1,273 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      https://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package android.security;
+
+import android.annotation.IntDef;
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.os.Parcel;
+import android.os.Parcelable;
+import android.security.keystore.KeyProperties;
+
+import java.lang.annotation.Retention;
+import java.lang.annotation.RetentionPolicy;
+import java.util.Arrays;
+import java.util.Objects;
+
+/**
+ * One exact-digest signing request for a granted external {@link KeyChain} key.
+ *
+ * @hide
+ */
+public final class KeyChainExternalSignatureRequest implements Parcelable, AutoCloseable {
+    /** RSASSA-PKCS1-v1_5 with SHA-256 and an RSA key. */
+    public static final int SIGNATURE_ALGORITHM_RSA_PKCS1_SHA256 = 1;
+
+    /** RSASSA-PSS with SHA-256, MGF1-SHA-256, and a digest-length salt. */
+    public static final int SIGNATURE_ALGORITHM_RSA_PSS_SHA256 = 2;
+
+    /** ECDSA with a P-384 key and a SHA-256 digest. */
+    public static final int SIGNATURE_ALGORITHM_ECDSA_P384_SHA256 = 3;
+
+    /** ECDSA with a P-384 key and a SHA-384 digest. */
+    public static final int SIGNATURE_ALGORITHM_ECDSA_P384_SHA384 = 4;
+
+    /** @hide */
+    @IntDef(
+            prefix = {"SIGNATURE_ALGORITHM_"},
+            value = {
+                SIGNATURE_ALGORITHM_RSA_PKCS1_SHA256,
+                SIGNATURE_ALGORITHM_RSA_PSS_SHA256,
+                SIGNATURE_ALGORITHM_ECDSA_P384_SHA256,
+                SIGNATURE_ALGORITHM_ECDSA_P384_SHA384
+            })
+    @Retention(RetentionPolicy.SOURCE)
+    public @interface SignatureAlgorithm {}
+
+    private static final int NO_SPECIAL_CONTENTS = 0;
+    private static final int SHA256_DIGEST_LENGTH_BITS = 256;
+    private static final int SHA384_DIGEST_LENGTH_BITS = 384;
+    private static final int SHA256_DIGEST_LENGTH_BYTES = SHA256_DIGEST_LENGTH_BITS / Byte.SIZE;
+    private static final int SHA384_DIGEST_LENGTH_BYTES = SHA384_DIGEST_LENGTH_BITS / Byte.SIZE;
+    private static final long FIRST_PROVIDER_GENERATION = 1L;
+    private static final byte CLEARED_BYTE = 0;
+
+    private final @NonNull String mExternalAlias;
+    private final @SignatureAlgorithm int mAlgorithm;
+    private final long mProviderGeneration;
+    private @Nullable byte[] mOwnedDigest;
+
+    private KeyChainExternalSignatureRequest(
+            @NonNull String externalAlias,
+            @SignatureAlgorithm int algorithm,
+            @NonNull byte[] ownedDigest,
+            long providerGeneration) {
+        Objects.requireNonNull(ownedDigest);
+        try {
+            Objects.requireNonNull(externalAlias);
+            validate(externalAlias, algorithm, ownedDigest, providerGeneration);
+        } catch (RuntimeException exception) {
+            Arrays.fill(ownedDigest, CLEARED_BYTE);
+            throw exception;
+        }
+        mExternalAlias = externalAlias;
+        mAlgorithm = algorithm;
+        mOwnedDigest = ownedDigest;
+        mProviderGeneration = providerGeneration;
+    }
+
+    private KeyChainExternalSignatureRequest(@NonNull Parcel source) {
+        this(
+                readRequiredString(source),
+                source.readInt(),
+                readRequiredByteArray(source),
+                source.readLong());
+    }
+
+    /** Creates a request and takes a defensive copy of {@code digest}. @hide */
+    @NonNull
+    public static KeyChainExternalSignatureRequest create(
+            @NonNull String externalAlias,
+            @SignatureAlgorithm int algorithm,
+            @NonNull byte[] digest,
+            long providerGeneration) {
+        return new KeyChainExternalSignatureRequest(
+                externalAlias,
+                algorithm,
+                Objects.requireNonNull(digest).clone(),
+                providerGeneration);
+    }
+
+    /** @hide */
+    @NonNull
+    public String getExternalAlias() {
+        return mExternalAlias;
+    }
+
+    /** @hide */
+    public @SignatureAlgorithm int getAlgorithm() {
+        return mAlgorithm;
+    }
+
+    /** @hide */
+    public long getProviderGeneration() {
+        return mProviderGeneration;
+    }
+
+    /** Returns a defensive copy of the exact digest. @hide */
+    @NonNull
+    public synchronized byte[] copyDigest() {
+        return requireDigest().clone();
+    }
+
+    /** Returns the exact digest length for a supported algorithm. @hide */
+    public static int getDigestLengthBytes(@SignatureAlgorithm int algorithm) {
+        switch (algorithm) {
+            case SIGNATURE_ALGORITHM_RSA_PKCS1_SHA256:
+            case SIGNATURE_ALGORITHM_RSA_PSS_SHA256:
+            case SIGNATURE_ALGORITHM_ECDSA_P384_SHA256:
+                return SHA256_DIGEST_LENGTH_BYTES;
+            case SIGNATURE_ALGORITHM_ECDSA_P384_SHA384:
+                return SHA384_DIGEST_LENGTH_BYTES;
+            default:
+                throw new IllegalArgumentException("Unknown external signature algorithm");
+        }
+    }
+
+    /** Returns the private-key algorithm required by a supported signature. @hide */
+    @NonNull
+    public static String getKeyAlgorithm(@SignatureAlgorithm int algorithm) {
+        switch (algorithm) {
+            case SIGNATURE_ALGORITHM_RSA_PKCS1_SHA256:
+            case SIGNATURE_ALGORITHM_RSA_PSS_SHA256:
+                return KeyProperties.KEY_ALGORITHM_RSA;
+            case SIGNATURE_ALGORITHM_ECDSA_P384_SHA256:
+            case SIGNATURE_ALGORITHM_ECDSA_P384_SHA384:
+                return KeyProperties.KEY_ALGORITHM_EC;
+            default:
+                throw new IllegalArgumentException("Unknown external signature algorithm");
+        }
+    }
+
+    @Override
+    public synchronized int describeContents() {
+        return NO_SPECIAL_CONTENTS;
+    }
+
+    @Override
+    public synchronized void writeToParcel(@NonNull Parcel destination, int flags) {
+        destination.writeString(mExternalAlias);
+        destination.writeInt(mAlgorithm);
+        destination.writeByteArray(requireDigest());
+        destination.writeLong(mProviderGeneration);
+    }
+
+    @Override
+    public synchronized void close() {
+        if (mOwnedDigest != null) {
+            Arrays.fill(mOwnedDigest, CLEARED_BYTE);
+            mOwnedDigest = null;
+        }
+    }
+
+    @Override
+    public synchronized String toString() {
+        return "KeyChainExternalSignatureRequest{"
+                + "algorithm="
+                + algorithmName(mAlgorithm)
+                + ", digestLength="
+                + getDigestLengthBytes(mAlgorithm)
+                + ", providerGeneration="
+                + mProviderGeneration
+                + ", closed="
+                + (mOwnedDigest == null)
+                + '}';
+    }
+
+    @NonNull
+    public static final Parcelable.Creator<KeyChainExternalSignatureRequest> CREATOR =
+            new Parcelable.Creator<KeyChainExternalSignatureRequest>() {
+                @Override
+                public KeyChainExternalSignatureRequest createFromParcel(Parcel source) {
+                    return new KeyChainExternalSignatureRequest(source);
+                }
+
+                @Override
+                public KeyChainExternalSignatureRequest[] newArray(int size) {
+                    return new KeyChainExternalSignatureRequest[size];
+                }
+            };
+
+    private static void validate(
+            @NonNull String externalAlias,
+            @SignatureAlgorithm int algorithm,
+            @NonNull byte[] digest,
+            long providerGeneration) {
+        if (externalAlias.isEmpty()) {
+            throw new IllegalArgumentException("External alias is empty");
+        }
+        int expectedDigestLength = getDigestLengthBytes(algorithm);
+        if (digest.length != expectedDigestLength) {
+            throw new IllegalArgumentException("External signature digest has the wrong length");
+        }
+        if (providerGeneration < FIRST_PROVIDER_GENERATION) {
+            throw new IllegalArgumentException("External provider generation must be positive");
+        }
+    }
+
+    @NonNull
+    private synchronized byte[] requireDigest() {
+        byte[] ownedDigest = mOwnedDigest;
+        if (ownedDigest == null) {
+            throw new IllegalStateException("External signature request is closed");
+        }
+        return ownedDigest;
+    }
+
+    @NonNull
+    private static String readRequiredString(@NonNull Parcel source) {
+        String value = source.readString();
+        if (value == null) {
+            throw new IllegalArgumentException("External alias is absent");
+        }
+        return value;
+    }
+
+    @NonNull
+    private static byte[] readRequiredByteArray(@NonNull Parcel source) {
+        byte[] value = source.createByteArray();
+        if (value == null) {
+            throw new IllegalArgumentException("External signature digest is absent");
+        }
+        return value;
+    }
+
+    private static String algorithmName(@SignatureAlgorithm int algorithm) {
+        switch (algorithm) {
+            case SIGNATURE_ALGORITHM_RSA_PKCS1_SHA256:
+                return "RSA_PKCS1_SHA256";
+            case SIGNATURE_ALGORITHM_RSA_PSS_SHA256:
+                return "RSA_PSS_SHA256";
+            case SIGNATURE_ALGORITHM_ECDSA_P384_SHA256:
+                return "ECDSA_P384_SHA256";
+            case SIGNATURE_ALGORITHM_ECDSA_P384_SHA384:
+                return "ECDSA_P384_SHA384";
+            default:
+                return "UNKNOWN";
+        }
+    }
+}
