+import android.os.Parcel;
+import android.security.keystore.KeyProperties;
+
+import androidx.test.runner.AndroidJUnit4;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+
+/** Unit tests for the external KeyChain signature parcelables. */
+@RunWith(AndroidJUnit4.class)
+public final class KeyChainExternalSignatureParcelTest {
+    private static final String SYNTHETIC_EXTERNAL_ALIAS = "synthetic-external-alias";
+    private static final String SYNTHETIC_SIGNATURE_TEXT = "synthetic-signature";
+    private static final String EMPTY_TEXT = "";
+    private static final byte[] SYNTHETIC_SIGNATURE =
+            SYNTHETIC_SIGNATURE_TEXT.getBytes(StandardCharsets.US_ASCII);
+    private static final long SYNTHETIC_PROVIDER_GENERATION = 7L;
+    private static final long NO_PROVIDER_GENERATION = 0L;
+    private static final int UNKNOWN_SIGNATURE_ALGORITHM = Integer.MAX_VALUE;
+    private static final int UNKNOWN_FAILURE = Integer.MAX_VALUE;
+    private static final int PARCEL_START_POSITION = 0;
+    private static final int NO_REMAINING_PARCEL_BYTES = 0;
+    private static final int EMPTY_SIGNATURE_LENGTH_BYTES = 0;
+    private static final int MINIMUM_DIGEST_LENGTH_BYTES = 1;
+    private static final int FIRST_BYTE_INDEX = 0;
+    private static final int SINGLE_MISSING_BYTE_COUNT = 1;
+    private static final byte SYNTHETIC_DIGEST_FILL = 'd';
+    private static final byte MODIFIED_BYTE = 'x';
+
+    private static final int[] SUPPORTED_ALGORITHMS = {
+        KeyChainExternalSignatureRequest.SIGNATURE_ALGORITHM_RSA_PKCS1_SHA256,
+        KeyChainExternalSignatureRequest.SIGNATURE_ALGORITHM_RSA_PSS_SHA256,
+        KeyChainExternalSignatureRequest.SIGNATURE_ALGORITHM_ECDSA_P384_SHA256,
+        KeyChainExternalSignatureRequest.SIGNATURE_ALGORITHM_ECDSA_P384_SHA384
+    };
+
+    private static final int[] COARSE_FAILURES = {
+        KeyChainExternalSignatureResult.FAILURE_INVALID_REQUEST,
+        KeyChainExternalSignatureResult.FAILURE_PROVIDER_UNAVAILABLE,
+        KeyChainExternalSignatureResult.FAILURE_PROVIDER_GENERATION_CHANGED,
+        KeyChainExternalSignatureResult.FAILURE_USER_CANCELLED,
+        KeyChainExternalSignatureResult.FAILURE_USER_TIMED_OUT,
+        KeyChainExternalSignatureResult.FAILURE_CALLER_INTERRUPTED,
+        KeyChainExternalSignatureResult.FAILURE_SIGNING_FAILED,
+        KeyChainExternalSignatureResult.FAILURE_INTERNAL_ERROR
+    };
+
+    @Test
+    public void supportedAlgorithmsHaveClosedDigestAndKeyMappings() {
+        for (int algorithm : SUPPORTED_ALGORITHMS) {
+            int digestLength = KeyChainExternalSignatureRequest.getDigestLengthBytes(algorithm);
+            String keyAlgorithm = KeyChainExternalSignatureRequest.getKeyAlgorithm(algorithm);
+
+            assertTrue(digestLength >= MINIMUM_DIGEST_LENGTH_BYTES);
+            if (algorithm == KeyChainExternalSignatureRequest.SIGNATURE_ALGORITHM_RSA_PKCS1_SHA256
+                    || algorithm
+                            == KeyChainExternalSignatureRequest
+                                    .SIGNATURE_ALGORITHM_RSA_PSS_SHA256) {
+                assertEquals(KeyProperties.KEY_ALGORITHM_RSA, keyAlgorithm);
+            } else {
+                assertEquals(KeyProperties.KEY_ALGORITHM_EC, keyAlgorithm);
+            }
+        }
+    }
+
+    @Test
+    public void requestRoundTripsAndDefensivelyCopiesDigest() {
+        int algorithm = KeyChainExternalSignatureRequest.SIGNATURE_ALGORITHM_ECDSA_P384_SHA384;
+        byte[] expectedDigest = syntheticDigest(algorithm);
+        byte[] inputDigest = expectedDigest.clone();
+        KeyChainExternalSignatureRequest request =
+                KeyChainExternalSignatureRequest.create(
+                        SYNTHETIC_EXTERNAL_ALIAS,
+                        algorithm,
+                        inputDigest,
+                        SYNTHETIC_PROVIDER_GENERATION);
+        inputDigest[FIRST_BYTE_INDEX] = MODIFIED_BYTE;
+
+        byte[] returnedDigest = request.copyDigest();
+        assertArrayEquals(expectedDigest, returnedDigest);
+        returnedDigest[FIRST_BYTE_INDEX] = MODIFIED_BYTE;
+
+        KeyChainExternalSignatureRequest restored = requestParcelRoundTrip(request);
+
+        assertEquals(SYNTHETIC_EXTERNAL_ALIAS, restored.getExternalAlias());
+        assertEquals(algorithm, restored.getAlgorithm());
+        assertArrayEquals(expectedDigest, restored.copyDigest());
+        assertEquals(SYNTHETIC_PROVIDER_GENERATION, restored.getProviderGeneration());
+        request.close();
+        restored.close();
+        Arrays.fill(expectedDigest, MODIFIED_BYTE);
+    }
+
+    @Test
+    public void requestRejectsMalformedFieldsAndUseAfterClose() {
+        int algorithm = KeyChainExternalSignatureRequest.SIGNATURE_ALGORITHM_RSA_PKCS1_SHA256;
+        byte[] digest = syntheticDigest(algorithm);
+        byte[] shortDigest = Arrays.copyOf(digest, digest.length - SINGLE_MISSING_BYTE_COUNT);
+
+        assertThrows(
+                IllegalArgumentException.class,
+                () ->
+                        KeyChainExternalSignatureRequest.create(
+                                EMPTY_TEXT, algorithm, digest, SYNTHETIC_PROVIDER_GENERATION));
+        assertThrows(
+                IllegalArgumentException.class,
+                () ->
+                        KeyChainExternalSignatureRequest.create(
+                                SYNTHETIC_EXTERNAL_ALIAS,
+                                UNKNOWN_SIGNATURE_ALGORITHM,
+                                digest,
+                                SYNTHETIC_PROVIDER_GENERATION));
+        assertThrows(
+                IllegalArgumentException.class,
+                () ->
+                        KeyChainExternalSignatureRequest.create(
+                                SYNTHETIC_EXTERNAL_ALIAS,
+                                algorithm,
+                                shortDigest,
+                                SYNTHETIC_PROVIDER_GENERATION));
+        assertThrows(
+                IllegalArgumentException.class,
+                () ->
+                        KeyChainExternalSignatureRequest.create(
+                                SYNTHETIC_EXTERNAL_ALIAS,
+                                algorithm,
+                                digest,
+                                NO_PROVIDER_GENERATION));
+
+        KeyChainExternalSignatureRequest request =
+                KeyChainExternalSignatureRequest.create(
+                        SYNTHETIC_EXTERNAL_ALIAS, algorithm, digest, SYNTHETIC_PROVIDER_GENERATION);
+        request.close();
+        assertThrows(IllegalStateException.class, request::copyDigest);
+        Arrays.fill(digest, MODIFIED_BYTE);
+        Arrays.fill(shortDigest, MODIFIED_BYTE);
+    }
+
+    @Test
+    public void requestParcelRejectsUnknownAlgorithm() {
+        Parcel parcel = Parcel.obtain();
+        try {
+            parcel.writeString(SYNTHETIC_EXTERNAL_ALIAS);
+            parcel.writeInt(UNKNOWN_SIGNATURE_ALGORITHM);
+            parcel.writeByteArray(
+                    syntheticDigest(
+                            KeyChainExternalSignatureRequest.SIGNATURE_ALGORITHM_RSA_PKCS1_SHA256));
+            parcel.writeLong(SYNTHETIC_PROVIDER_GENERATION);
+            parcel.setDataPosition(PARCEL_START_POSITION);
+
+            assertThrows(
+                    IllegalArgumentException.class,
+                    () -> KeyChainExternalSignatureRequest.CREATOR.createFromParcel(parcel));
+        } finally {
+            parcel.recycle();
+        }
+    }
+
+    @Test
+    public void successResultRoundTripsAndDefensivelyCopiesSignature() {
+        byte[] expectedSignature = SYNTHETIC_SIGNATURE.clone();
+        byte[] inputSignature = expectedSignature.clone();
+        KeyChainExternalSignatureResult result =
+                KeyChainExternalSignatureResult.success(inputSignature);
+        inputSignature[FIRST_BYTE_INDEX] = MODIFIED_BYTE;
+
+        byte[] returnedSignature = result.copySignature();
+        assertArrayEquals(expectedSignature, returnedSignature);
+        returnedSignature[FIRST_BYTE_INDEX] = MODIFIED_BYTE;
+
+        KeyChainExternalSignatureResult restored = resultParcelRoundTrip(result);
+
+        assertTrue(restored.isSuccess());
+        assertEquals(KeyChainExternalSignatureResult.FAILURE_NONE, restored.getFailure());
+        assertArrayEquals(expectedSignature, restored.copySignature());
+        result.close();
+        restored.close();
+        assertThrows(IllegalStateException.class, result::copySignature);
+        Arrays.fill(expectedSignature, MODIFIED_BYTE);
+    }
+
+    @Test
+    public void everyCoarseFailureRoundTripsWithoutSignatureBytes() {
+        for (int failure : COARSE_FAILURES) {
+            KeyChainExternalSignatureResult result =
+                    KeyChainExternalSignatureResult.failure(failure);
+            KeyChainExternalSignatureResult restored = resultParcelRoundTrip(result);
+
+            assertFalse(restored.isSuccess());
+            assertEquals(failure, restored.getFailure());
+            assertThrows(IllegalStateException.class, restored::copySignature);
+            result.close();
+            restored.close();
+        }
+    }
+
+    @Test
+    public void resultRejectsEmptySuccessNoneFailureAndUnknownFailure() {
+        assertThrows(
+                IllegalArgumentException.class,
+                () ->
+                        KeyChainExternalSignatureResult.success(
+                                new byte[EMPTY_SIGNATURE_LENGTH_BYTES]));
+        assertThrows(
+                IllegalArgumentException.class,
+                () ->
+                        KeyChainExternalSignatureResult.failure(
+                                KeyChainExternalSignatureResult.FAILURE_NONE));
+        assertThrows(
+                IllegalArgumentException.class,
+                () -> KeyChainExternalSignatureResult.failure(UNKNOWN_FAILURE));
+    }
+
+    @Test
+    public void stringFormsOmitAliasDigestAndSignatureMaterial() {
+        int algorithm = KeyChainExternalSignatureRequest.SIGNATURE_ALGORITHM_RSA_PKCS1_SHA256;
+        byte[] digest = syntheticDigest(algorithm);
+        String digestText = new String(digest, StandardCharsets.US_ASCII);
+        KeyChainExternalSignatureRequest request =
+                KeyChainExternalSignatureRequest.create(
+                        SYNTHETIC_EXTERNAL_ALIAS, algorithm, digest, SYNTHETIC_PROVIDER_GENERATION);
+        KeyChainExternalSignatureResult result =
+                KeyChainExternalSignatureResult.success(SYNTHETIC_SIGNATURE);
+
+        assertFalse(request.toString().contains(SYNTHETIC_EXTERNAL_ALIAS));
+        assertFalse(request.toString().contains(digestText));
+        assertFalse(result.toString().contains(SYNTHETIC_SIGNATURE_TEXT));
+        request.close();
+        result.close();
+        Arrays.fill(digest, MODIFIED_BYTE);
+    }
+
+    private static byte[] syntheticDigest(int algorithm) {
+        byte[] digest = new byte[KeyChainExternalSignatureRequest.getDigestLengthBytes(algorithm)];
+        Arrays.fill(digest, SYNTHETIC_DIGEST_FILL);
+        return digest;
+    }
+
+    private static KeyChainExternalSignatureRequest requestParcelRoundTrip(
+            KeyChainExternalSignatureRequest request) {
+        Parcel parcel = Parcel.obtain();
+        try {
+            request.writeToParcel(parcel, request.describeContents());
+            parcel.setDataPosition(PARCEL_START_POSITION);
+            KeyChainExternalSignatureRequest restored =
+                    KeyChainExternalSignatureRequest.CREATOR.createFromParcel(parcel);
+            assertEquals(NO_REMAINING_PARCEL_BYTES, parcel.dataAvail());
+            return restored;
+        } finally {
+            parcel.recycle();
+        }
+    }
+
+    private static KeyChainExternalSignatureResult resultParcelRoundTrip(
+            KeyChainExternalSignatureResult result) {
+        Parcel parcel = Parcel.obtain();
+        try {
+            result.writeToParcel(parcel, result.describeContents());
+            parcel.setDataPosition(PARCEL_START_POSITION);
+            KeyChainExternalSignatureResult restored =
+                    KeyChainExternalSignatureResult.CREATOR.createFromParcel(parcel);
+            assertEquals(NO_REMAINING_PARCEL_BYTES, parcel.dataAvail());
+            return restored;
+        } finally {
+            parcel.recycle();
+        }
+    }
