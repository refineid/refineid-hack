+++ b/keystore/java/android/security/KeyChainExternalSignatureResult.java
@@ -0,0 +1,241 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      https://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package android.security;
+
+import android.annotation.IntDef;
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.os.Parcel;
+import android.os.Parcelable;
+
+import java.lang.annotation.Retention;
+import java.lang.annotation.RetentionPolicy;
+import java.util.Arrays;
+import java.util.Objects;
+
+/**
+ * Coarse result of one external {@link KeyChain} signing request.
+ *
+ * <p>A successful RSA signature has the fixed-width JCA form. A successful ECDSA signature has the
+ * ASN.1 DER sequence form required by JCA.
+ *
+ * @hide
+ */
+public final class KeyChainExternalSignatureResult implements Parcelable, AutoCloseable {
+    /** No failure occurred. */
+    public static final int FAILURE_NONE = 0;
+
+    /** The request did not satisfy the closed external-key contract. */
+    public static final int FAILURE_INVALID_REQUEST = 1;
+
+    /** The trusted external-key provider is not currently available. */
+    public static final int FAILURE_PROVIDER_UNAVAILABLE = 2;
+
+    /** The provider changed after the private-key handle was obtained. */
+    public static final int FAILURE_PROVIDER_GENERATION_CHANGED = 3;
+
+    /** The holder cancelled authorization. */
+    public static final int FAILURE_USER_CANCELLED = 4;
+
+    /** Holder authorization timed out. */
+    public static final int FAILURE_USER_TIMED_OUT = 5;
+
+    /** The calling operation was interrupted. */
+    public static final int FAILURE_CALLER_INTERRUPTED = 6;
+
+    /** The external provider rejected or could not verify the signature operation. */
+    public static final int FAILURE_SIGNING_FAILED = 7;
+
+    /** The trusted service failed without exposing internal details. */
+    public static final int FAILURE_INTERNAL_ERROR = 8;
+
+    /** @hide */
+    @IntDef(
+            prefix = {"FAILURE_"},
+            value = {
+                FAILURE_NONE,
+                FAILURE_INVALID_REQUEST,
+                FAILURE_PROVIDER_UNAVAILABLE,
+                FAILURE_PROVIDER_GENERATION_CHANGED,
+                FAILURE_USER_CANCELLED,
+                FAILURE_USER_TIMED_OUT,
+                FAILURE_CALLER_INTERRUPTED,
+                FAILURE_SIGNING_FAILED,
+                FAILURE_INTERNAL_ERROR
+            })
+    @Retention(RetentionPolicy.SOURCE)
+    public @interface Failure {}
+
+    private static final int NO_SPECIAL_CONTENTS = 0;
+    private static final int NO_SIGNATURE_LENGTH_BYTES = 0;
+    private static final int MINIMUM_SIGNATURE_LENGTH_BYTES = 1;
+    private static final byte CLEARED_BYTE = 0;
+
+    private final @Failure int mFailure;
+    private @Nullable byte[] mOwnedSignature;
+
+    private KeyChainExternalSignatureResult(@Failure int failure, @Nullable byte[] ownedSignature) {
+        try {
+            validate(failure, ownedSignature);
+        } catch (RuntimeException exception) {
+            if (ownedSignature != null) {
+                Arrays.fill(ownedSignature, CLEARED_BYTE);
+            }
+            throw exception;
+        }
+        mFailure = failure;
+        mOwnedSignature = ownedSignature;
+    }
+
+    private KeyChainExternalSignatureResult(@NonNull Parcel source) {
+        this(source.readInt(), source.createByteArray());
+    }
+
+    /** Creates a successful result and takes a defensive copy of {@code signature}. @hide */
+    @NonNull
+    public static KeyChainExternalSignatureResult success(@NonNull byte[] signature) {
+        return new KeyChainExternalSignatureResult(
+                FAILURE_NONE, Objects.requireNonNull(signature).clone());
+    }
+
+    /** Creates a coarse failed result. @hide */
+    @NonNull
+    public static KeyChainExternalSignatureResult failure(@Failure int failure) {
+        return new KeyChainExternalSignatureResult(failure, null);
+    }
+
+    /** @hide */
+    public boolean isSuccess() {
+        return mFailure == FAILURE_NONE;
+    }
+
+    /** @hide */
+    public @Failure int getFailure() {
+        return mFailure;
+    }
+
+    /** Returns a defensive copy of a successful signature. @hide */
+    @NonNull
+    public synchronized byte[] copySignature() {
+        if (!isSuccess()) {
+            throw new IllegalStateException("External signature result is a failure");
+        }
+        byte[] ownedSignature = mOwnedSignature;
+        if (ownedSignature == null) {
+            throw new IllegalStateException("External signature result is closed");
+        }
+        return ownedSignature.clone();
+    }
+
+    @Override
+    public int describeContents() {
+        return NO_SPECIAL_CONTENTS;
+    }
+
+    @Override
+    public synchronized void writeToParcel(@NonNull Parcel destination, int flags) {
+        destination.writeInt(mFailure);
+        if (isSuccess() && mOwnedSignature == null) {
+            throw new IllegalStateException("External signature result is closed");
+        }
+        destination.writeByteArray(mOwnedSignature);
+    }
+
+    @Override
+    public synchronized void close() {
+        if (mOwnedSignature != null) {
+            Arrays.fill(mOwnedSignature, CLEARED_BYTE);
+            mOwnedSignature = null;
+        }
+    }
+
+    @Override
+    public synchronized String toString() {
+        return "KeyChainExternalSignatureResult{"
+                + "failure="
+                + failureName(mFailure)
+                + ", signatureLength="
+                + (mOwnedSignature == null ? NO_SIGNATURE_LENGTH_BYTES : mOwnedSignature.length)
+                + ", closed="
+                + (isSuccess() && mOwnedSignature == null)
+                + '}';
+    }
+
+    @NonNull
+    public static final Parcelable.Creator<KeyChainExternalSignatureResult> CREATOR =
+            new Parcelable.Creator<KeyChainExternalSignatureResult>() {
+                @Override
+                public KeyChainExternalSignatureResult createFromParcel(Parcel source) {
+                    return new KeyChainExternalSignatureResult(source);
+                }
+
+                @Override
+                public KeyChainExternalSignatureResult[] newArray(int size) {
+                    return new KeyChainExternalSignatureResult[size];
+                }
+            };
+
+    private static void validate(@Failure int failure, @Nullable byte[] signature) {
+        switch (failure) {
+            case FAILURE_NONE:
+                if (signature == null || signature.length < MINIMUM_SIGNATURE_LENGTH_BYTES) {
+                    throw new IllegalArgumentException("Successful external signature is empty");
+                }
+                return;
+            case FAILURE_INVALID_REQUEST:
+            case FAILURE_PROVIDER_UNAVAILABLE:
+            case FAILURE_PROVIDER_GENERATION_CHANGED:
+            case FAILURE_USER_CANCELLED:
+            case FAILURE_USER_TIMED_OUT:
+            case FAILURE_CALLER_INTERRUPTED:
+            case FAILURE_SIGNING_FAILED:
+            case FAILURE_INTERNAL_ERROR:
+                if (signature != null) {
+                    throw new IllegalArgumentException(
+                            "Failed external signature contains signature bytes");
+                }
+                return;
+            default:
+                throw new IllegalArgumentException("Unknown external signature failure");
+        }
+    }
+
+    private static String failureName(@Failure int failure) {
+        switch (failure) {
+            case FAILURE_NONE:
+                return "NONE";
+            case FAILURE_INVALID_REQUEST:
+                return "INVALID_REQUEST";
+            case FAILURE_PROVIDER_UNAVAILABLE:
+                return "PROVIDER_UNAVAILABLE";
+            case FAILURE_PROVIDER_GENERATION_CHANGED:
+                return "PROVIDER_GENERATION_CHANGED";
+            case FAILURE_USER_CANCELLED:
+                return "USER_CANCELLED";
+            case FAILURE_USER_TIMED_OUT:
+                return "USER_TIMED_OUT";
+            case FAILURE_CALLER_INTERRUPTED:
+                return "CALLER_INTERRUPTED";
+            case FAILURE_SIGNING_FAILED:
+                return "SIGNING_FAILED";
+            case FAILURE_INTERNAL_ERROR:
+                return "INTERNAL_ERROR";
+            default:
+                return "UNKNOWN";
+        }
+    }
+}
