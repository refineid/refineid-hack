+    @NonNull
+    private static KeyChainExternalSignatureRequest readFromParcel(@NonNull Parcel source) {
+        byte[] ownedDigest = null;
+        boolean ownershipTransferred = false;
+        try {
+            String externalAlias = readRequiredString(source);
+            int algorithm = source.readInt();
+            ownedDigest = readRequiredByteArray(source);
+            long providerGeneration = source.readLong();
+            IBinder operationToken = readRequiredBinder(source);
+            KeyChainExternalSignatureRequest request =
+                    new KeyChainExternalSignatureRequest(
+                            externalAlias,
+                            algorithm,
+                            ownedDigest,
+                            providerGeneration,
+                            operationToken);
+            ownershipTransferred = true;
+            return request;
+        } finally {
+            if (!ownershipTransferred && ownedDigest != null) {
+                Arrays.fill(ownedDigest, CLEARED_BYTE);
+            }
+        }
+    }
