diff --git a/keystore/java/android/security/KeyChainPrivateKeyDescriptor.java b/keystore/java/android/security/KeyChainPrivateKeyDescriptor.java
new file mode 100644
index 00000000..e9832dcb
--- /dev/null
+++ b/keystore/java/android/security/KeyChainPrivateKeyDescriptor.java
@@ -0,0 +1,259 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package android.security;
+
+import android.annotation.IntDef;
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.os.Parcel;
+import android.os.Parcelable;
+import android.security.keystore.KeyProperties;
+
+import java.lang.annotation.Retention;
+import java.lang.annotation.RetentionPolicy;
+
+/**
+ * Describes how {@link KeyChain} can obtain a granted private key.
+ *
+ * @hide
+ */
+public final class KeyChainPrivateKeyDescriptor implements Parcelable {
+    /** The private key is an existing Keystore2 grant. */
+    public static final int TYPE_KEYSTORE_GRANT = 1;
+
+    /** The private key delegates signing to a trusted external provider. */
+    public static final int TYPE_EXTERNAL_KEY = 2;
+
+    /** @hide */
+    @IntDef(
+            prefix = {"TYPE_"},
+            value = {TYPE_KEYSTORE_GRANT, TYPE_EXTERNAL_KEY})
+    @Retention(RetentionPolicy.SOURCE)
+    public @interface Type {}
+
+    private static final int NO_SPECIAL_CONTENTS = 0;
+    private static final int NO_ENCODED_PUBLIC_KEY_LENGTH_BYTES = 0;
+    private static final int MINIMUM_ENCODED_PUBLIC_KEY_LENGTH_BYTES = 1;
+    private static final long NO_PROVIDER_GENERATION = 0L;
+    private static final long FIRST_PROVIDER_GENERATION = 1L;
+
+    private final @Type int mType;
+    private final @Nullable String mKeyStoreGrant;
+    private final @Nullable String mExternalAlias;
+    private final @Nullable String mAlgorithm;
+    private final @Nullable byte[] mEncodedPublicKey;
+    private final long mProviderGeneration;
+
+    private KeyChainPrivateKeyDescriptor(
+            @Type int type,
+            @Nullable String keyStoreGrant,
+            @Nullable String externalAlias,
+            @Nullable String algorithm,
+            @Nullable byte[] encodedPublicKey,
+            long providerGeneration) {
+        validate(
+                type,
+                keyStoreGrant,
+                externalAlias,
+                algorithm,
+                encodedPublicKey,
+                providerGeneration);
+        mType = type;
+        mKeyStoreGrant = keyStoreGrant;
+        mExternalAlias = externalAlias;
+        mAlgorithm = algorithm;
+        mEncodedPublicKey = encodedPublicKey == null ? null : encodedPublicKey.clone();
+        mProviderGeneration = providerGeneration;
+    }
+
+    private KeyChainPrivateKeyDescriptor(@NonNull Parcel source) {
+        this(
+                source.readInt(),
+                source.readString(),
+                source.readString(),
+                source.readString(),
+                source.createByteArray(),
+                source.readLong());
+    }
+
+    /** Creates a descriptor for the existing Keystore2 grant path. @hide */
+    @NonNull
+    public static KeyChainPrivateKeyDescriptor forKeyStoreGrant(@NonNull String keyStoreGrant) {
+        return new KeyChainPrivateKeyDescriptor(
+                TYPE_KEYSTORE_GRANT, keyStoreGrant, null, null, null, NO_PROVIDER_GENERATION);
+    }
+
+    /**
+     * Creates a descriptor for a trusted external signing key.
+     *
+     * <p>{@code encodedPublicKey} contains an X.509 SubjectPublicKeyInfo encoding.
+     *
+     * @hide
+     */
+    @NonNull
+    public static KeyChainPrivateKeyDescriptor forExternalKey(
+            @NonNull String externalAlias,
+            @NonNull String algorithm,
+            @NonNull byte[] encodedPublicKey,
+            long providerGeneration) {
+        return new KeyChainPrivateKeyDescriptor(
+                TYPE_EXTERNAL_KEY,
+                null,
+                externalAlias,
+                algorithm,
+                encodedPublicKey,
+                providerGeneration);
+    }
+
+    /** @hide */
+    public @Type int getType() {
+        return mType;
+    }
+
+    /** @hide */
+    @Nullable
+    public String getKeyStoreGrant() {
+        return mKeyStoreGrant;
+    }
+
+    /** @hide */
+    @Nullable
+    public String getExternalAlias() {
+        return mExternalAlias;
+    }
+
+    /** @hide */
+    @Nullable
+    public String getAlgorithm() {
+        return mAlgorithm;
+    }
+
+    /** Returns the X.509 SubjectPublicKeyInfo encoding for an external key. @hide */
+    @Nullable
+    public byte[] getEncodedPublicKey() {
+        return mEncodedPublicKey == null ? null : mEncodedPublicKey.clone();
+    }
+
+    /** @hide */
+    public long getProviderGeneration() {
+        return mProviderGeneration;
+    }
+
+    @Override
+    public int describeContents() {
+        return NO_SPECIAL_CONTENTS;
+    }
+
+    @Override
+    public void writeToParcel(@NonNull Parcel destination, int flags) {
+        destination.writeInt(mType);
+        destination.writeString(mKeyStoreGrant);
+        destination.writeString(mExternalAlias);
+        destination.writeString(mAlgorithm);
+        destination.writeByteArray(mEncodedPublicKey);
+        destination.writeLong(mProviderGeneration);
+    }
+
+    @Override
+    public String toString() {
+        return "KeyChainPrivateKeyDescriptor{"
+                + "type="
+                + typeName(mType)
+                + ", algorithm="
+                + mAlgorithm
+                + ", publicKeyLength="
+                + (mEncodedPublicKey == null
+                        ? NO_ENCODED_PUBLIC_KEY_LENGTH_BYTES
+                        : mEncodedPublicKey.length)
+                + ", providerGeneration="
+                + mProviderGeneration
+                + '}';
+    }
+
+    @NonNull
+    public static final Parcelable.Creator<KeyChainPrivateKeyDescriptor> CREATOR =
+            new Parcelable.Creator<KeyChainPrivateKeyDescriptor>() {
+                @Override
+                public KeyChainPrivateKeyDescriptor createFromParcel(Parcel source) {
+                    return new KeyChainPrivateKeyDescriptor(source);
+                }
+
+                @Override
+                public KeyChainPrivateKeyDescriptor[] newArray(int size) {
+                    return new KeyChainPrivateKeyDescriptor[size];
+                }
+            };
+
+    private static void validate(
+            @Type int type,
+            @Nullable String keyStoreGrant,
+            @Nullable String externalAlias,
+            @Nullable String algorithm,
+            @Nullable byte[] encodedPublicKey,
+            long providerGeneration) {
+        switch (type) {
+            case TYPE_KEYSTORE_GRANT:
+                requireNonEmpty(keyStoreGrant, "Keystore grant");
+                if (externalAlias != null
+                        || algorithm != null
+                        || encodedPublicKey != null
+                        || providerGeneration != NO_PROVIDER_GENERATION) {
+                    throw new IllegalArgumentException(
+                            "Keystore grant descriptor contains external-key fields");
+                }
+                return;
+            case TYPE_EXTERNAL_KEY:
+                if (keyStoreGrant != null) {
+                    throw new IllegalArgumentException(
+                            "External-key descriptor contains a Keystore grant");
+                }
+                requireNonEmpty(externalAlias, "External alias");
+                if (!KeyProperties.KEY_ALGORITHM_RSA.equals(algorithm)
+                        && !KeyProperties.KEY_ALGORITHM_EC.equals(algorithm)) {
+                    throw new IllegalArgumentException("Unsupported external-key algorithm");
+                }
+                if (encodedPublicKey == null
+                        || encodedPublicKey.length < MINIMUM_ENCODED_PUBLIC_KEY_LENGTH_BYTES) {
+                    throw new IllegalArgumentException("External public key is empty");
+                }
+                if (providerGeneration < FIRST_PROVIDER_GENERATION) {
+                    throw new IllegalArgumentException(
+                            "External provider generation must be positive");
+                }
+                return;
+            default:
+                throw new IllegalArgumentException("Unknown private-key descriptor type");
+        }
+    }
+
+    private static void requireNonEmpty(@Nullable String value, @NonNull String fieldName) {
+        if (value == null || value.isEmpty()) {
+            throw new IllegalArgumentException(fieldName + " is empty");
+        }
+    }
+
+    private static String typeName(@Type int type) {
+        switch (type) {
+            case TYPE_KEYSTORE_GRANT:
+                return "KEYSTORE_GRANT";
+            case TYPE_EXTERNAL_KEY:
+                return "EXTERNAL_KEY";
+            default:
+                return "UNKNOWN";
+        }
+    }
+}
diff --git a/keystore/tests/src/android/security/KeyChainPrivateKeyDescriptorTest.java b/keystore/tests/src/android/security/KeyChainPrivateKeyDescriptorTest.java
new file mode 100644
index 00000000..323f6058
--- /dev/null
+++ b/keystore/tests/src/android/security/KeyChainPrivateKeyDescriptorTest.java
@@ -0,0 +1,184 @@
+/*
