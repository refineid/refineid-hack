+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package android.security;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertThrows;
+
+import android.os.Parcel;
+import android.security.keystore.KeyProperties;
+
+import androidx.test.runner.AndroidJUnit4;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Objects;
+
+/** Unit tests for {@link KeyChainPrivateKeyDescriptor}. */
+@RunWith(AndroidJUnit4.class)
+public final class KeyChainPrivateKeyDescriptorTest {
+    private static final String SYNTHETIC_KEYSTORE_GRANT = "synthetic-keystore-grant";
+    private static final String SYNTHETIC_EXTERNAL_ALIAS = "synthetic-external-alias";
+    private static final String SYNTHETIC_PUBLIC_KEY_TEXT = "synthetic-public-key";
+    private static final String EMPTY_TEXT = "";
+    private static final byte[] SYNTHETIC_PUBLIC_KEY =
+            SYNTHETIC_PUBLIC_KEY_TEXT.getBytes(StandardCharsets.US_ASCII);
+    private static final long SYNTHETIC_PROVIDER_GENERATION = 7L;
+    private static final long NO_PROVIDER_GENERATION = 0L;
+    private static final long INVALID_PROVIDER_GENERATION = 0L;
+    private static final int UNKNOWN_DESCRIPTOR_TYPE = Integer.MAX_VALUE;
+    private static final int PARCEL_START_POSITION = 0;
+    private static final int NO_REMAINING_PARCEL_BYTES = 0;
+    private static final int EMPTY_PUBLIC_KEY_LENGTH_BYTES = 0;
+    private static final int FIRST_BYTE_INDEX = 0;
+    private static final byte MODIFIED_PUBLIC_KEY_BYTE = 'x';
+
+    @Test
+    public void keyStoreGrantRoundTripsWithoutExternalFields() {
+        KeyChainPrivateKeyDescriptor descriptor =
+                KeyChainPrivateKeyDescriptor.forKeyStoreGrant(SYNTHETIC_KEYSTORE_GRANT);
+
+        KeyChainPrivateKeyDescriptor restored = parcelRoundTrip(descriptor);
+
+        assertEquals(KeyChainPrivateKeyDescriptor.TYPE_KEYSTORE_GRANT, restored.getType());
+        assertEquals(SYNTHETIC_KEYSTORE_GRANT, restored.getKeyStoreGrant());
+        assertNull(restored.getExternalAlias());
+        assertNull(restored.getAlgorithm());
+        assertNull(restored.getEncodedPublicKey());
+        assertEquals(NO_PROVIDER_GENERATION, restored.getProviderGeneration());
+    }
+
+    @Test
+    public void externalKeyRoundTripsAndDefensivelyCopiesPublicMaterial() {
+        byte[] inputPublicKey = SYNTHETIC_PUBLIC_KEY.clone();
+        KeyChainPrivateKeyDescriptor descriptor =
+                KeyChainPrivateKeyDescriptor.forExternalKey(
+                        SYNTHETIC_EXTERNAL_ALIAS,
+                        KeyProperties.KEY_ALGORITHM_RSA,
+                        inputPublicKey,
+                        SYNTHETIC_PROVIDER_GENERATION);
+        inputPublicKey[FIRST_BYTE_INDEX] = MODIFIED_PUBLIC_KEY_BYTE;
+
+        byte[] returnedPublicKey = Objects.requireNonNull(descriptor.getEncodedPublicKey());
+        assertArrayEquals(SYNTHETIC_PUBLIC_KEY, returnedPublicKey);
+        returnedPublicKey[FIRST_BYTE_INDEX] = MODIFIED_PUBLIC_KEY_BYTE;
+
+        KeyChainPrivateKeyDescriptor restored = parcelRoundTrip(descriptor);
+
+        assertEquals(KeyChainPrivateKeyDescriptor.TYPE_EXTERNAL_KEY, restored.getType());
+        assertNull(restored.getKeyStoreGrant());
+        assertEquals(SYNTHETIC_EXTERNAL_ALIAS, restored.getExternalAlias());
+        assertEquals(KeyProperties.KEY_ALGORITHM_RSA, restored.getAlgorithm());
+        assertArrayEquals(SYNTHETIC_PUBLIC_KEY, restored.getEncodedPublicKey());
+        assertEquals(SYNTHETIC_PROVIDER_GENERATION, restored.getProviderGeneration());
+    }
+
+    @Test
+    public void factoriesRejectMalformedDescriptors() {
+        assertThrows(
+                IllegalArgumentException.class,
+                () -> KeyChainPrivateKeyDescriptor.forKeyStoreGrant(EMPTY_TEXT));
+        assertThrows(
+                IllegalArgumentException.class,
+                () ->
+                        KeyChainPrivateKeyDescriptor.forExternalKey(
+                                EMPTY_TEXT,
+                                KeyProperties.KEY_ALGORITHM_RSA,
+                                SYNTHETIC_PUBLIC_KEY,
+                                SYNTHETIC_PROVIDER_GENERATION));
+        assertThrows(
+                IllegalArgumentException.class,
+                () ->
+                        KeyChainPrivateKeyDescriptor.forExternalKey(
+                                SYNTHETIC_EXTERNAL_ALIAS,
+                                KeyProperties.KEY_ALGORITHM_AES,
+                                SYNTHETIC_PUBLIC_KEY,
+                                SYNTHETIC_PROVIDER_GENERATION));
+        assertThrows(
+                IllegalArgumentException.class,
+                () ->
+                        KeyChainPrivateKeyDescriptor.forExternalKey(
+                                SYNTHETIC_EXTERNAL_ALIAS,
+                                KeyProperties.KEY_ALGORITHM_RSA,
+                                new byte[EMPTY_PUBLIC_KEY_LENGTH_BYTES],
+                                SYNTHETIC_PROVIDER_GENERATION));
+        assertThrows(
+                IllegalArgumentException.class,
+                () ->
+                        KeyChainPrivateKeyDescriptor.forExternalKey(
+                                SYNTHETIC_EXTERNAL_ALIAS,
+                                KeyProperties.KEY_ALGORITHM_RSA,
+                                SYNTHETIC_PUBLIC_KEY,
+                                INVALID_PROVIDER_GENERATION));
+    }
+
+    @Test
+    public void parcelRejectsUnknownDescriptorType() {
+        Parcel parcel = Parcel.obtain();
+        try {
+            parcel.writeInt(UNKNOWN_DESCRIPTOR_TYPE);
+            parcel.writeString(null);
+            parcel.writeString(null);
+            parcel.writeString(null);
+            parcel.writeByteArray(null);
+            parcel.writeLong(INVALID_PROVIDER_GENERATION);
+            parcel.setDataPosition(PARCEL_START_POSITION);
+
+            assertThrows(
+                    IllegalArgumentException.class,
+                    () -> KeyChainPrivateKeyDescriptor.CREATOR.createFromParcel(parcel));
+        } finally {
+            parcel.recycle();
+        }
+    }
+
+    @Test
+    public void stringFormOmitsCapabilityAliasAndPublicKey() {
+        KeyChainPrivateKeyDescriptor keyStoreDescriptor =
+                KeyChainPrivateKeyDescriptor.forKeyStoreGrant(SYNTHETIC_KEYSTORE_GRANT);
+        KeyChainPrivateKeyDescriptor externalDescriptor =
+                KeyChainPrivateKeyDescriptor.forExternalKey(
+                        SYNTHETIC_EXTERNAL_ALIAS,
+                        KeyProperties.KEY_ALGORITHM_RSA,
+                        SYNTHETIC_PUBLIC_KEY,
+                        SYNTHETIC_PROVIDER_GENERATION);
+
+        assertFalse(keyStoreDescriptor.toString().contains(SYNTHETIC_KEYSTORE_GRANT));
+        assertFalse(externalDescriptor.toString().contains(SYNTHETIC_EXTERNAL_ALIAS));
+        assertFalse(externalDescriptor.toString().contains(SYNTHETIC_PUBLIC_KEY_TEXT));
+    }
+
+    private static KeyChainPrivateKeyDescriptor parcelRoundTrip(
+            KeyChainPrivateKeyDescriptor descriptor) {
+        Parcel parcel = Parcel.obtain();
+        try {
+            descriptor.writeToParcel(parcel, descriptor.describeContents());
+            parcel.setDataPosition(PARCEL_START_POSITION);
+            KeyChainPrivateKeyDescriptor restored =
+                    KeyChainPrivateKeyDescriptor.CREATOR.createFromParcel(parcel);
+            assertEquals(NO_REMAINING_PARCEL_BYTES, parcel.dataAvail());
+            return restored;
+        } finally {
+            parcel.recycle();
+        }
+    }
+}
