+    private RecordingSigningOperation newOperation() {
+        RecordingSigningOperation operation = new RecordingSigningOperation();
+        mOperations.add(operation);
+        return operation;
+    }
+
+    private static KeyChainExternalPrivateKey externalKey(
+            String algorithm, RecordingSigningOperation operation) {
+        return new KeyChainExternalPrivateKey(
+                SYNTHETIC_EXTERNAL_ALIAS, algorithm, SYNTHETIC_PROVIDER_GENERATION, operation);
+    }
+
+    private static byte[] syntheticDigest(int algorithm) {
+        int digestLength = KeyChainExternalSignatureRequest.getDigestLengthBytes(algorithm);
+        byte[] digest = new byte[digestLength];
+        Arrays.fill(digest, SYNTHETIC_DIGEST_FILL);
+        return digest;
+    }
+
+    private static byte[] concatenate(byte[] first, byte[] second) {
+        byte[] result = Arrays.copyOf(first, first.length + second.length);
+        System.arraycopy(second, FIRST_BYTE_INDEX, result, first.length, second.length);
+        return result;
+    }
+
+    private static int providerPosition(Provider provider) {
+        if (provider == null) {
+            return PROVIDER_NOT_INSTALLED_POSITION;
+        }
+        Provider[] providers = Security.getProviders();
+        for (int index = FIRST_PROVIDER_ARRAY_INDEX; index < providers.length; index++) {
+            if (provider == providers[index]) {
+                return index + ZERO_BASED_TO_ONE_BASED_OFFSET;
+            }
+        }
+        return PROVIDER_NOT_INSTALLED_POSITION;
+    }
+
+    private static final class SignatureCase {
+        final String jcaName;
+        final String digestJcaName;
+        final String keyAlgorithm;
+        final int requestAlgorithm;
+
+        SignatureCase(
+                String jcaName, String digestJcaName, String keyAlgorithm, int requestAlgorithm) {
+            this.jcaName = jcaName;
+            this.digestJcaName = digestJcaName;
+            this.keyAlgorithm = keyAlgorithm;
+            this.requestAlgorithm = requestAlgorithm;
+        }
+    }
+
+    private static final class RecordingSigningOperation
+            implements KeyChainExternalPrivateKey.SigningOperation, AutoCloseable {
+        static final int NO_CALLS = 0;
+        private static final int SINGLE_CALL_INCREMENT = 1;
+
+        int callCount;
+        int observedAlgorithm;
+        byte[] observedDigest;
+        KeyChainExternalSignatureRequest observedRequest;
+        KeyChainExternalSignatureResult returnedResult;
+        Integer failure;
+        RuntimeException runtimeFailure;
+        AssertionError assertionFailure;
+
+        @Override
+        public KeyChainExternalSignatureResult sign(KeyChainExternalSignatureRequest request) {
+            callCount += SINGLE_CALL_INCREMENT;
+            observedRequest = request;
+            observedAlgorithm = request.getAlgorithm();
+            observedDigest = request.copyDigest();
+            if (runtimeFailure != null) {
+                throw runtimeFailure;
+            }
+            if (assertionFailure != null) {
+                throw assertionFailure;
+            }
+            if (failure != null) {
+                returnedResult = KeyChainExternalSignatureResult.failure(failure);
+            } else {
+                returnedResult =
+                        KeyChainExternalSignatureResult.success(SYNTHETIC_SERVICE_SIGNATURE);
+            }
+            return returnedResult;
+        }
+
+        void assertRequestAndResultClosed() {
+            assertThrows(
+                    IllegalStateException.class,
+                    Objects.requireNonNull(observedRequest)::copyDigest);
+            assertThrows(
+                    IllegalStateException.class,
+                    Objects.requireNonNull(returnedResult)::copySignature);
+        }
+
+        @Override
+        public void close() {
+            if (observedDigest != null) {
+                Arrays.fill(observedDigest, CLEARED_BYTE);
+                observedDigest = null;
+            }
+            if (returnedResult != null) {
+                returnedResult.close();
+                returnedResult = null;
+            }
+            observedRequest = null;
+            runtimeFailure = null;
+            assertionFailure = null;
+            failure = null;
+        }
+    }
+}
