+        KeyChainExternalPrivateKey rsaKey = externalKey(KeyProperties.KEY_ALGORITHM_RSA, operation);
+        byte[] digest =
+                syntheticDigest(
+                        KeyChainExternalSignatureRequest.SIGNATURE_ALGORITHM_RSA_PKCS1_SHA256);
+        SignatureException exception =
+                assertThrows(
+                        SignatureException.class,
+                        () -> rsaKey.sign(UNKNOWN_SIGNATURE_ALGORITHM, digest));
+        assertEquals(COARSE_SIGNING_FAILURE_TEXT, exception.getMessage());
+        assertEquals(RecordingSigningOperation.NO_CALLS, operation.callCount);
+        Arrays.fill(digest, CLEARED_BYTE);
