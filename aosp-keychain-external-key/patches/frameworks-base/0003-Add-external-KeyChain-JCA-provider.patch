+package android.security;
+
+import java.security.Provider;
+
+/** JCA signatures for framework-owned external KeyChain private keys. @hide */
+public final class KeyChainExternalKeyProvider extends Provider {
+    static final String PROVIDER_NAME = "KeyChainExternalKey";
+
+    static final String JCA_SHA256_WITH_RSA = "SHA256withRSA";
+    static final String JCA_SHA256_WITH_RSA_PSS = "SHA256withRSA/PSS";
+    static final String JCA_SHA256_WITH_ECDSA = "SHA256withECDSA";
+    static final String JCA_SHA384_WITH_ECDSA = "SHA384withECDSA";
+    static final String JCA_NONE_WITH_RSA = "NONEwithRSA";
+    static final String JCA_NONE_WITH_ECDSA = "NONEwithECDSA";
+
+    private static final long serialVersionUID = 1L;
+    private static final double PROVIDER_VERSION = 1.0;
+    private static final String PROVIDER_DESCRIPTION = "Android KeyChain external-key signatures";
+    private static final String PACKAGE_NAME = "android.security";
+    private static final String EXTERNAL_PRIVATE_KEY_CLASS_NAME =
+            PACKAGE_NAME + ".KeyChainExternalPrivateKey";
+
+    @SuppressWarnings("deprecation")
+    public KeyChainExternalKeyProvider() {
+        super(PROVIDER_NAME, PROVIDER_VERSION, PROVIDER_DESCRIPTION);
+
+        putSignature(
+                JCA_SHA256_WITH_RSA, PACKAGE_NAME + ".KeyChainExternalSignatureSpi$Sha256WithRsa");
+        putSignature(
+                JCA_SHA256_WITH_RSA_PSS,
+                PACKAGE_NAME + ".KeyChainExternalSignatureSpi$Sha256WithRsaPss");
+        putSignature(
+                JCA_SHA256_WITH_ECDSA,
+                PACKAGE_NAME + ".KeyChainExternalSignatureSpi$Sha256WithEcdsa");
+        putSignature(
+                JCA_SHA384_WITH_ECDSA,
+                PACKAGE_NAME + ".KeyChainExternalSignatureSpi$Sha384WithEcdsa");
+        putSignature(JCA_NONE_WITH_RSA, PACKAGE_NAME + ".KeyChainExternalSignatureSpi$NoneWithRsa");
+        putSignature(
+                JCA_NONE_WITH_ECDSA, PACKAGE_NAME + ".KeyChainExternalSignatureSpi$NoneWithEcdsa");
+    }
+
+    private void putSignature(String algorithm, String implementationClass) {
+        put("Signature." + algorithm, implementationClass);
+        put("Signature." + algorithm + " SupportedKeyClasses", EXTERNAL_PRIVATE_KEY_CLASS_NAME);
+    }
+}
