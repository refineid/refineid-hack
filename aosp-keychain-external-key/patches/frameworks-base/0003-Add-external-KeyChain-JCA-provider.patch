+        assertThrows(
+                java.security.InvalidKeyException.class,
+                () ->
+                        ecdsaSigner.initSign(
+                                externalKey(KeyProperties.KEY_ALGORITHM_RSA, operation)));
+        assertEquals(RecordingSigningOperation.NO_CALLS, operation.callCount);
