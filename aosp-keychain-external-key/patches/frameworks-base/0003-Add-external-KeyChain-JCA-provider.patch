+
+package android.security;
+
+import android.annotation.NonNull;
+import android.content.Context;
+
+import java.security.GeneralSecurityException;
+import java.security.KeyFactory;
+import java.security.KeyPair;
+import java.security.PrivateKey;
+import java.security.PublicKey;
+import java.security.spec.X509EncodedKeySpec;
+import java.util.Objects;
+
+/** Constructs a JCA key pair from a validated external-key descriptor. @hide */
+final class KeyChainExternalKeyFactory {
+    private KeyChainExternalKeyFactory() {}
+
+    @NonNull
+    static KeyPair fromDescriptor(
+            @NonNull Context context, @NonNull KeyChainPrivateKeyDescriptor privateKeyDescriptor)
+            throws KeyChainException {
+        try {
+            String algorithm = Objects.requireNonNull(privateKeyDescriptor.getAlgorithm());
+            byte[] encodedPublicKey =
+                    Objects.requireNonNull(privateKeyDescriptor.getEncodedPublicKey());
+            PublicKey publicKey =
+                    KeyFactory.getInstance(algorithm)
+                            .generatePublic(new X509EncodedKeySpec(encodedPublicKey));
+            if (!algorithm.equals(publicKey.getAlgorithm())) {
+                throw new IllegalArgumentException("External public-key algorithm changed");
+            }
+            PrivateKey privateKey =
+                    new KeyChainExternalPrivateKey(
+                            Objects.requireNonNull(context),
+                            Objects.requireNonNull(privateKeyDescriptor.getExternalAlias()),
+                            algorithm,
+                            privateKeyDescriptor.getProviderGeneration());
+            return new KeyPair(publicKey, privateKey);
+        } catch (GeneralSecurityException | RuntimeException exception) {
+            throw new KeyChainException(
+                    new IllegalStateException("Invalid external KeyChain descriptor"));
+        }
+    }
+}
