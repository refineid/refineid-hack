+ * limitations under the License.
+ */
+
+package android.security;
+
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.content.Context;
+import android.os.RemoteException;
+import android.security.keystore.KeyProperties;
+
+import java.io.NotSerializableException;
+import java.io.ObjectStreamException;
+import java.security.PrivateKey;
+import java.security.SignatureException;
+import java.util.Objects;
+
+/**
+ * Non-exportable JCA handle for a granted external {@link KeyChain} key.
+ *
+ * @hide
+ */
+public final class KeyChainExternalPrivateKey implements PrivateKey {
+    private static final long serialVersionUID = 1L;
+    private static final long FIRST_PROVIDER_GENERATION = 1L;
+    private static final String SIGNING_FAILURE_MESSAGE = "External KeyChain signing failed";
+
+    private final @NonNull String mExternalAlias;
+    private final @NonNull String mAlgorithm;
+    private final long mProviderGeneration;
+    private final transient @NonNull SigningOperation mSigningOperation;
+
+    KeyChainExternalPrivateKey(
+            @NonNull Context context,
+            @NonNull String externalAlias,
+            @NonNull String algorithm,
+            long providerGeneration) {
+        this(
+                externalAlias,
+                algorithm,
+                providerGeneration,
+                new KeyChainServiceSigningOperation(
+                        applicationContext(Objects.requireNonNull(context))));
+    }
+
+    KeyChainExternalPrivateKey(
+            @NonNull String externalAlias,
+            @NonNull String algorithm,
+            long providerGeneration,
+            @NonNull SigningOperation signingOperation) {
+        validate(externalAlias, algorithm, providerGeneration);
+        mExternalAlias = externalAlias;
+        mAlgorithm = algorithm;
+        mProviderGeneration = providerGeneration;
+        mSigningOperation = Objects.requireNonNull(signingOperation);
+    }
+
+    @Override
+    @NonNull
+    public String getAlgorithm() {
+        return mAlgorithm;
+    }
+
+    @Override
+    @Nullable
+    public String getFormat() {
+        return null;
+    }
+
+    @Override
+    @Nullable
+    public byte[] getEncoded() {
+        return null;
+    }
+
+    @Override
+    public String toString() {
+        return "KeyChainExternalPrivateKey{"
+                + "algorithm="
+                + mAlgorithm
+                + ", providerGeneration="
+                + mProviderGeneration
+                + '}';
+    }
+
+    @NonNull
+    byte[] sign(
+            @KeyChainExternalSignatureRequest.SignatureAlgorithm int signatureAlgorithm,
+            @NonNull byte[] digest)
+            throws SignatureException {
+        String requiredKeyAlgorithm;
+        try {
+            requiredKeyAlgorithm =
+                    KeyChainExternalSignatureRequest.getKeyAlgorithm(signatureAlgorithm);
+        } catch (RuntimeException exception) {
+            throw signingFailure();
+        }
+        if (!mAlgorithm.equals(requiredKeyAlgorithm)) {
+            throw signingFailure();
+        }
+        KeyChainExternalSignatureRequest request;
+        try {
+            request =
+                    KeyChainExternalSignatureRequest.create(
+                            mExternalAlias,
+                            signatureAlgorithm,
+                            Objects.requireNonNull(digest),
+                            mProviderGeneration);
+        } catch (RuntimeException exception) {
+            throw signingFailure();
+        }
+        try (KeyChainExternalSignatureRequest ownedRequest = request) {
+            KeyChainExternalSignatureResult result;
+            try {
+                result = mSigningOperation.sign(ownedRequest);
+            } catch (SignatureException | RuntimeException | AssertionError exception) {
+                throw signingFailure();
+            }
+            if (result == null) {
+                throw signingFailure();
+            }
+            try (KeyChainExternalSignatureResult ownedResult = result) {
+                if (!ownedResult.isSuccess()) {
+                    throw signingFailure();
+                }
+                try {
+                    return ownedResult.copySignature();
+                } catch (RuntimeException exception) {
+                    throw signingFailure();
+                }
+            }
+        }
+    }
+
+    private Object writeReplace() throws ObjectStreamException {
+        throw new NotSerializableException("External KeyChain keys cannot be serialized");
+    }
+
+    private static void validate(
+            @NonNull String externalAlias, @NonNull String algorithm, long providerGeneration) {
+        Objects.requireNonNull(externalAlias);
+        Objects.requireNonNull(algorithm);
+        if (externalAlias.isEmpty()) {
+            throw new IllegalArgumentException("External alias is empty");
+        }
+        if (!KeyProperties.KEY_ALGORITHM_RSA.equals(algorithm)
+                && !KeyProperties.KEY_ALGORITHM_EC.equals(algorithm)) {
+            throw new IllegalArgumentException("Unsupported external-key algorithm");
+        }
+        if (providerGeneration < FIRST_PROVIDER_GENERATION) {
+            throw new IllegalArgumentException("External provider generation must be positive");
+        }
+    }
+
+    private static SignatureException signingFailure() {
+        return new SignatureException(SIGNING_FAILURE_MESSAGE);
+    }
+
+    @NonNull
+    private static Context applicationContext(@NonNull Context context) {
+        Context applicationContext = context.getApplicationContext();
+        return applicationContext == null ? context : applicationContext;
+    }
+
+    interface SigningOperation {
+        KeyChainExternalSignatureResult sign(KeyChainExternalSignatureRequest request)
+                throws SignatureException;
+    }
+
+    private static final class KeyChainServiceSigningOperation implements SigningOperation {
+        private final @NonNull Context mContext;
+
+        KeyChainServiceSigningOperation(@NonNull Context context) {
+            mContext = Objects.requireNonNull(context);
+        }
+
+        @Override
+        public KeyChainExternalSignatureResult sign(KeyChainExternalSignatureRequest request)
+                throws SignatureException {
+            try (KeyChain.KeyChainConnection connection = KeyChain.bind(mContext)) {
+                return connection.getService().requestExternalSignature(request);
+            } catch (InterruptedException exception) {
+                Thread.currentThread().interrupt();
+                throw signingFailure();
+            } catch (RemoteException | RuntimeException | AssertionError exception) {
+                throw signingFailure();
+            }
+        }
+    }
+}
diff --git a/keystore/java/android/security/KeyChainExternalSignatureSpi.java b/keystore/java/android/security/KeyChainExternalSignatureSpi.java
new file mode 100644
index 00000000..26cdedc0
--- /dev/null
+++ b/keystore/java/android/security/KeyChainExternalSignatureSpi.java
@@ -0,0 +1,479 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      https://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package android.security;
+
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.security.keystore.KeyProperties;
+
+import java.security.InvalidAlgorithmParameterException;
+import java.security.InvalidKeyException;
+import java.security.InvalidParameterException;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.security.PrivateKey;
+import java.security.ProviderException;
+import java.security.PublicKey;
+import java.security.SecureRandom;
+import java.security.SignatureException;
+import java.security.SignatureSpi;
+import java.security.spec.AlgorithmParameterSpec;
+import java.security.spec.MGF1ParameterSpec;
+import java.security.spec.PSSParameterSpec;
+import java.util.Arrays;
+
+/** JCA signature implementations for {@link KeyChainExternalPrivateKey}. @hide */
+public abstract class KeyChainExternalSignatureSpi extends SignatureSpi {
+    private static final String SIGNATURE_NOT_INITIALIZED_MESSAGE =
+            "External KeyChain signature is not initialized";
+    private static final String SIGNATURE_CONSUMED_MESSAGE =
+            "External KeyChain signature was already consumed";
+    private static final String SIGNATURE_PARAMETERS_FIXED_MESSAGE =
+            "External KeyChain signature parameters are fixed";
+
+    private final @NonNull String mRequiredKeyAlgorithm;
+    private final @NonNull SignatureInput mInput;
+    private @Nullable KeyChainExternalPrivateKey mKey;
+    private boolean mConsumed;
+
+    KeyChainExternalSignatureSpi(
+            @NonNull String requiredKeyAlgorithm, @NonNull SignatureInput input) {
+        mRequiredKeyAlgorithm = requiredKeyAlgorithm;
+        mInput = input;
+    }
+
+    @Override
+    protected final void engineInitVerify(PublicKey publicKey) throws InvalidKeyException {
+        reset();
+        throw new InvalidKeyException("External KeyChain signatures do not verify");
+    }
+
+    @Override
+    protected final void engineInitSign(PrivateKey privateKey) throws InvalidKeyException {
+        initSign(privateKey);
+    }
+
+    @Override
+    protected final void engineInitSign(PrivateKey privateKey, SecureRandom random)
+            throws InvalidKeyException {
+        initSign(privateKey);
+    }
+
+    @Override
+    protected final void engineUpdate(byte input) throws SignatureException {
+        requireReady();
+        mInput.update(input);
+    }
+
+    @Override
+    protected final void engineUpdate(byte[] input, int offset, int length)
+            throws SignatureException {
+        requireReady();
+        mInput.update(input, offset, length);
+    }
+
+    @Override
+    protected final byte[] engineSign() throws SignatureException {
+        KeyChainExternalPrivateKey key = requireReady();
+        mConsumed = true;
+        PreparedInput preparedInput = null;
+        try {
+            preparedInput = mInput.prepare();
+            return key.sign(preparedInput.getAlgorithm(), preparedInput.getDigest());
+        } finally {
+            if (preparedInput != null) {
+                preparedInput.close();
+            }
+            mInput.reset();
+        }
+    }
+
+    @Override
+    protected final boolean engineVerify(byte[] signature) throws SignatureException {
+        throw new SignatureException("External KeyChain signatures do not verify");
+    }
+
+    @Override
+    @Deprecated
+    protected final void engineSetParameter(String parameter, Object value) {
+        throw new InvalidParameterException(SIGNATURE_PARAMETERS_FIXED_MESSAGE);
+    }
+
+    @Override
+    @Deprecated
+    protected final Object engineGetParameter(String parameter) {
+        throw new InvalidParameterException(SIGNATURE_PARAMETERS_FIXED_MESSAGE);
+    }
+
+    @Override
+    protected final void engineSetParameter(AlgorithmParameterSpec parameters)
+            throws InvalidAlgorithmParameterException {
+        validateParameters(parameters);
+    }
+
+    void validateParameters(AlgorithmParameterSpec parameters)
+            throws InvalidAlgorithmParameterException {
+        throw new InvalidAlgorithmParameterException(SIGNATURE_PARAMETERS_FIXED_MESSAGE);
+    }
+
+    private void initSign(PrivateKey privateKey) throws InvalidKeyException {
+        reset();
+        if (!(privateKey instanceof KeyChainExternalPrivateKey)) {
+            throw new InvalidKeyException("An external KeyChain private key is required");
+        }
+        KeyChainExternalPrivateKey externalPrivateKey = (KeyChainExternalPrivateKey) privateKey;
+        if (!mRequiredKeyAlgorithm.equals(externalPrivateKey.getAlgorithm())) {
+            throw new InvalidKeyException(
+                    "External KeyChain key algorithm does not match the signature");
+        }
+        mKey = externalPrivateKey;
+    }
+
+    @NonNull
+    private KeyChainExternalPrivateKey requireReady() throws SignatureException {
+        if (mConsumed) {
+            throw new SignatureException(SIGNATURE_CONSUMED_MESSAGE);
+        }
+        KeyChainExternalPrivateKey key = mKey;
+        if (key == null) {
+            throw new SignatureException(SIGNATURE_NOT_INITIALIZED_MESSAGE);
+        }
+        return key;
+    }
+
+    private void reset() {
+        mInput.reset();
+        mKey = null;
+        mConsumed = false;
+    }
+
+    /** SHA-256 with RSASSA-PKCS1-v1_5. @hide */
+    public static final class Sha256WithRsa extends KeyChainExternalSignatureSpi {
+        public Sha256WithRsa() {
+            super(
+                    KeyProperties.KEY_ALGORITHM_RSA,
+                    new HashedInput(
+                            Hash.SHA256,
+                            KeyChainExternalSignatureRequest.SIGNATURE_ALGORITHM_RSA_PKCS1_SHA256));
+        }
+    }
+
+    /** SHA-256 with RSASSA-PSS. @hide */
+    public static final class Sha256WithRsaPss extends KeyChainExternalSignatureSpi {
+        private static final String JCA_MGF1 = "MGF1";
+
+        public Sha256WithRsaPss() {
+            super(
+                    KeyProperties.KEY_ALGORITHM_RSA,
+                    new HashedInput(
+                            Hash.SHA256,
+                            KeyChainExternalSignatureRequest.SIGNATURE_ALGORITHM_RSA_PSS_SHA256));
+        }
+
+        @Override
+        void validateParameters(AlgorithmParameterSpec parameters)
+                throws InvalidAlgorithmParameterException {
+            if (!(parameters instanceof PSSParameterSpec)) {
+                throw new InvalidAlgorithmParameterException(SIGNATURE_PARAMETERS_FIXED_MESSAGE);
+            }
+            PSSParameterSpec pssParameters = (PSSParameterSpec) parameters;
+            AlgorithmParameterSpec maskGenerationParameters = pssParameters.getMGFParameters();
+            if (!Hash.SHA256.jcaName.equalsIgnoreCase(pssParameters.getDigestAlgorithm())
+                    || !JCA_MGF1.equalsIgnoreCase(pssParameters.getMGFAlgorithm())
+                    || !(maskGenerationParameters instanceof MGF1ParameterSpec)
+                    || !Hash.SHA256.jcaName.equalsIgnoreCase(
+                            ((MGF1ParameterSpec) maskGenerationParameters).getDigestAlgorithm())
+                    || pssParameters.getSaltLength() != Hash.SHA256.digestLengthBytes
+                    || pssParameters.getTrailerField()
+                            != PSSParameterSpec.DEFAULT.getTrailerField()) {
+                throw new InvalidAlgorithmParameterException(SIGNATURE_PARAMETERS_FIXED_MESSAGE);
+            }
+        }
+    }
+
+    /** SHA-256 with P-384 ECDSA. @hide */
+    public static final class Sha256WithEcdsa extends KeyChainExternalSignatureSpi {
+        public Sha256WithEcdsa() {
+            super(
+                    KeyProperties.KEY_ALGORITHM_EC,
+                    new HashedInput(
+                            Hash.SHA256,
+                            KeyChainExternalSignatureRequest
+                                    .SIGNATURE_ALGORITHM_ECDSA_P384_SHA256));
+        }
+    }
+
+    /** SHA-384 with P-384 ECDSA. @hide */
+    public static final class Sha384WithEcdsa extends KeyChainExternalSignatureSpi {
+        public Sha384WithEcdsa() {
+            super(
+                    KeyProperties.KEY_ALGORITHM_EC,
+                    new HashedInput(
+                            Hash.SHA384,
+                            KeyChainExternalSignatureRequest
+                                    .SIGNATURE_ALGORITHM_ECDSA_P384_SHA384));
+        }
+    }
+
+    /** Strict SHA-256 DigestInfo input with RSASSA-PKCS1-v1_5. @hide */
+    public static final class NoneWithRsa extends KeyChainExternalSignatureSpi {
+        public NoneWithRsa() {
+            super(KeyProperties.KEY_ALGORITHM_RSA, new RsaDigestInfoInput());
+        }
+    }
+
+    /** Exact SHA-256 or SHA-384 digest input with P-384 ECDSA. @hide */
+    public static final class NoneWithEcdsa extends KeyChainExternalSignatureSpi {
+        public NoneWithEcdsa() {
+            super(KeyProperties.KEY_ALGORITHM_EC, new EcdsaDigestInput());
+        }
+    }
+
+    private enum Hash {
+        SHA256(
+                "SHA-256",
+                KeyChainExternalSignatureRequest.getDigestLengthBytes(
+                        KeyChainExternalSignatureRequest.SIGNATURE_ALGORITHM_RSA_PKCS1_SHA256)),
+        SHA384(
+                "SHA-384",
+                KeyChainExternalSignatureRequest.getDigestLengthBytes(
+                        KeyChainExternalSignatureRequest.SIGNATURE_ALGORITHM_ECDSA_P384_SHA384));
+
+        final @NonNull String jcaName;
+        final int digestLengthBytes;
+
+        Hash(@NonNull String jcaName, int digestLengthBytes) {
+            this.jcaName = jcaName;
+            this.digestLengthBytes = digestLengthBytes;
+        }
+    }
+
+    private interface SignatureInput {
+        void update(byte input) throws SignatureException;
+
+        void update(byte[] input, int offset, int length) throws SignatureException;
+
+        PreparedInput prepare() throws SignatureException;
+
+        void reset();
+    }
+
+    private static final class HashedInput implements SignatureInput {
+        private final @NonNull MessageDigest mDigest;
+        private final @KeyChainExternalSignatureRequest.SignatureAlgorithm int mAlgorithm;
+
+        HashedInput(
+                @NonNull Hash hash,
+                @KeyChainExternalSignatureRequest.SignatureAlgorithm int algorithm) {
+            try {
+                mDigest = MessageDigest.getInstance(hash.jcaName);
+            } catch (NoSuchAlgorithmException exception) {
+                throw new ProviderException("Required message digest is unavailable");
+            }
+            mAlgorithm = algorithm;
+        }
+
+        @Override
+        public void update(byte input) {
+            mDigest.update(input);
+        }
+
+        @Override
+        public void update(byte[] input, int offset, int length) throws SignatureException {
+            validateInputRange(input, offset, length);
+            mDigest.update(input, offset, length);
+        }
+
+        @Override
+        public PreparedInput prepare() {
+            return new PreparedInput(mAlgorithm, mDigest.digest());
+        }
+
+        @Override
+        public void reset() {
+            mDigest.reset();
+        }
+    }
+
+    private abstract static class BoundedInput implements SignatureInput {
+        private static final byte CLEARED_BYTE = 0;
+        private static final int EMPTY_INPUT_LENGTH_BYTES = 0;
+        private static final int FIRST_ARRAY_INDEX = 0;
+
+        private final byte[] mBytes;
+        private int mLength;
+
+        BoundedInput(int maximumLengthBytes) {
+            mBytes = new byte[maximumLengthBytes];
+        }
+
+        @Override
+        public final void update(byte input) throws SignatureException {
+            if (mLength >= mBytes.length) {
+                throw new SignatureException("External signature input is too long");
+            }
+            mBytes[mLength] = input;
+            mLength += Byte.BYTES;
+        }
+
+        @Override
+        public final void update(byte[] input, int offset, int length) throws SignatureException {
+            validateInputRange(input, offset, length);
+            if (length > mBytes.length - mLength) {
+                throw new SignatureException("External signature input is too long");
+            }
+            System.arraycopy(input, offset, mBytes, mLength, length);
+            mLength += length;
+        }
+
+        @Override
+        public final PreparedInput prepare() throws SignatureException {
+            try {
+                return prepare(mBytes, mLength);
+            } finally {
+                reset();
+            }
+        }
+
+        @Override
+        public final void reset() {
+            Arrays.fill(mBytes, CLEARED_BYTE);
+            mLength = EMPTY_INPUT_LENGTH_BYTES;
+        }
+
+        abstract PreparedInput prepare(byte[] input, int length) throws SignatureException;
+    }
+
+    private static void validateInputRange(byte[] input, int offset, int length)
+            throws SignatureException {
+        if (input == null
+                || offset < BoundedInput.FIRST_ARRAY_INDEX
+                || length < BoundedInput.EMPTY_INPUT_LENGTH_BYTES
+                || offset > input.length
+                || length > input.length - offset) {
+            throw new SignatureException("External signature input range is invalid");
+        }
+    }
+
+    private static final class RsaDigestInfoInput extends BoundedInput {
+        // RFC 8017 section 9.2, note 1: DER prefix for id-sha256 DigestInfo.
+        private static final byte[] SHA256_DIGEST_INFO_PREFIX = {
+            0x30,
+            0x31,
+            0x30,
+            0x0d,
+            0x06,
+            0x09,
+            0x60,
+            (byte) 0x86,
+            0x48,
+            0x01,
+            0x65,
+            0x03,
+            0x04,
+            0x02,
+            0x01,
+            0x05,
+            0x00,
+            0x04,
+            0x20
+        };
+        private static final int INPUT_LENGTH_BYTES =
+                SHA256_DIGEST_INFO_PREFIX.length + Hash.SHA256.digestLengthBytes;
+
+        RsaDigestInfoInput() {
+            super(INPUT_LENGTH_BYTES);
+        }
+
+        @Override
+        PreparedInput prepare(byte[] input, int length) throws SignatureException {
+            if (length != INPUT_LENGTH_BYTES || !hasSha256Prefix(input)) {
+                throw new SignatureException("External RSA input is not SHA-256 DigestInfo");
+            }
+            byte[] digest =
+                    Arrays.copyOfRange(input, SHA256_DIGEST_INFO_PREFIX.length, INPUT_LENGTH_BYTES);
+            return new PreparedInput(
+                    KeyChainExternalSignatureRequest.SIGNATURE_ALGORITHM_RSA_PKCS1_SHA256, digest);
+        }
+
+        private static boolean hasSha256Prefix(byte[] input) {
+            for (int index = BoundedInput.FIRST_ARRAY_INDEX;
+                    index < SHA256_DIGEST_INFO_PREFIX.length;
+                    index++) {
+                if (input[index] != SHA256_DIGEST_INFO_PREFIX[index]) {
+                    return false;
+                }
+            }
+            return true;
+        }
+    }
+
+    private static final class EcdsaDigestInput extends BoundedInput {
+        EcdsaDigestInput() {
+            super(Hash.SHA384.digestLengthBytes);
+        }
+
+        @Override
+        PreparedInput prepare(byte[] input, int length) throws SignatureException {
+            final int algorithm;
+            if (length == Hash.SHA256.digestLengthBytes) {
+                algorithm = KeyChainExternalSignatureRequest.SIGNATURE_ALGORITHM_ECDSA_P384_SHA256;
+            } else if (length == Hash.SHA384.digestLengthBytes) {
+                algorithm = KeyChainExternalSignatureRequest.SIGNATURE_ALGORITHM_ECDSA_P384_SHA384;
+            } else {
+                throw new SignatureException("External ECDSA input has an unsupported length");
+            }
+            return new PreparedInput(algorithm, Arrays.copyOf(input, length));
+        }
+    }
+
+    private static final class PreparedInput implements AutoCloseable {
+        private static final byte CLEARED_BYTE = 0;
+
+        private final @KeyChainExternalSignatureRequest.SignatureAlgorithm int mAlgorithm;
+        private @Nullable byte[] mOwnedDigest;
+
+        PreparedInput(
+                @KeyChainExternalSignatureRequest.SignatureAlgorithm int algorithm,
+                @NonNull byte[] ownedDigest) {
+            mAlgorithm = algorithm;
+            mOwnedDigest = ownedDigest;
+        }
+
+        @KeyChainExternalSignatureRequest.SignatureAlgorithm
+        int getAlgorithm() {
+            return mAlgorithm;
+        }
+
+        @NonNull
+        byte[] getDigest() {
+            byte[] ownedDigest = mOwnedDigest;
+            if (ownedDigest == null) {
+                throw new IllegalStateException("Prepared external signature input is closed");
+            }
+            return ownedDigest;
+        }
+
+        @Override
+        public void close() {
+            if (mOwnedDigest != null) {
+                Arrays.fill(mOwnedDigest, CLEARED_BYTE);
+                mOwnedDigest = null;
+            }
+        }
+    }
+}
