+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.keychain;
+
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.content.Context;
+import android.os.RemoteException;
+import android.security.KeyChainExternalSignatureRequest;
+import android.security.KeyChainExternalSignatureResult;
+
+import com.android.internal.annotations.VisibleForTesting;
+import com.android.keychain.external.ExternalKeyProviderIdentity;
+import com.android.keychain.external.ExternalKeyProviderResult;
+import com.android.keychain.external.IExternalKeyProviderService;
+
+import java.security.cert.CertificateException;
+import java.util.Arrays;
+import java.util.Objects;
+
+/** Validating adapter over the statically trusted external-key Binder service. */
+final class BoundExternalKeyProvider implements ExternalKeyProvider {
+    interface Connection extends AutoCloseable {
+        @Nullable
+        IExternalKeyProviderService getService();
+
+        @Override
+        void close();
+    }
+
+    private static final byte CLEARED_BYTE = 0;
+
+    private final @NonNull Connection mConnection;
+    private boolean mClosed;
+
+    @NonNull
+    static BoundExternalKeyProvider create(@NonNull Context context) {
+        return new BoundExternalKeyProvider(TrustedExternalKeyProviderConnection.create(context));
+    }
+
+    @VisibleForTesting
+    BoundExternalKeyProvider(@NonNull Connection connection) {
+        mConnection = Objects.requireNonNull(connection);
+    }
+
+    @Override
+    @Nullable
+    public ExternalKeyIdentity getActiveIdentity() {
+        ExternalKeyProviderIdentity providerIdentity = null;
+        byte[] leafCertificate = null;
+        byte[] caCertificates = null;
+        try {
+            IExternalKeyProviderService service = getCompatibleService();
+            if (service == null) {
+                return null;
+            }
+            providerIdentity = service.getActiveIdentity();
+            if (providerIdentity == null) {
+                return null;
+            }
+            leafCertificate = providerIdentity.copyLeafCertificate();
+            caCertificates = providerIdentity.copyCaCertificates();
+            return ExternalKeyIdentity.create(
+                    leafCertificate, caCertificates, providerIdentity.getProviderGeneration());
+        } catch (RemoteException
+                | CertificateException
+                | RuntimeException
+                | AssertionError exception) {
+            return null;
+        } finally {
+            clear(leafCertificate);
+            clear(caCertificates);
+            if (providerIdentity != null) {
+                providerIdentity.close();
+            }
+        }
+    }
+
+    @Override
+    @NonNull
+    public KeyChainExternalSignatureResult sign(
+            @NonNull ExternalKeyCaller caller, @NonNull KeyChainExternalSignatureRequest request) {
+        Objects.requireNonNull(caller);
+        Objects.requireNonNull(request);
+
+        byte[] digest = null;
+        ExternalKeyProviderResult providerResult = null;
+        try {
+            IExternalKeyProviderService service = getCompatibleService();
+            if (service == null) {
+                return failure(KeyChainExternalSignatureResult.FAILURE_PROVIDER_UNAVAILABLE);
+            }
+            digest = request.copyDigest();
+            providerResult =
+                    service.sign(
+                            caller.getUid(),
+                            caller.copyPackageNames(),
+                            request.getExternalAlias(),
+                            request.getProviderGeneration(),
+                            toProviderAlgorithm(request.getAlgorithm()),
+                            digest,
+                            request.getOperationToken());
+            if (providerResult == null) {
+                return failure(KeyChainExternalSignatureResult.FAILURE_INTERNAL_ERROR);
+            }
+            if (!providerResult.isSuccess()) {
+                return failure(mapFailure(providerResult.getFailure()));
+            }
+            byte[] signature = providerResult.copySignature();
+            try {
+                return KeyChainExternalSignatureResult.success(signature);
+            } finally {
+                clear(signature);
+            }
+        } catch (RemoteException exception) {
+            return failure(KeyChainExternalSignatureResult.FAILURE_PROVIDER_UNAVAILABLE);
+        } catch (RuntimeException | AssertionError exception) {
+            return failure(KeyChainExternalSignatureResult.FAILURE_INTERNAL_ERROR);
+        } finally {
+            clear(digest);
+            if (providerResult != null) {
+                providerResult.close();
+            }
+        }
+    }
+
+    @Override
+    public boolean removeIdentity(long providerGeneration) {
+        try {
+            IExternalKeyProviderService service = getCompatibleService();
+            return service != null && service.removeIdentity(providerGeneration);
+        } catch (RemoteException | RuntimeException | AssertionError exception) {
+            return false;
+        }
+    }
+
+    @Override
+    public synchronized void close() {
+        if (mClosed) {
+            return;
+        }
+        mClosed = true;
+        try {
+            mConnection.close();
+        } catch (RuntimeException | AssertionError exception) {
+            // Closing is a best-effort transition to an unavailable provider.
+        }
+    }
+
+    @Override
+    public synchronized String toString() {
+        return "BoundExternalKeyProvider{closed=" + mClosed + '}';
+    }
+
+    @Nullable
+    private IExternalKeyProviderService getCompatibleService() throws RemoteException {
+        synchronized (this) {
+            if (mClosed) {
+                return null;
+            }
+        }
+        IExternalKeyProviderService service = mConnection.getService();
+        if (service == null
+                || service.getProtocolVersion() != IExternalKeyProviderService.PROTOCOL_VERSION) {
+            return null;
+        }
+        synchronized (this) {
+            return mClosed ? null : service;
+        }
+    }
+
+    @VisibleForTesting
+    static int toProviderAlgorithm(
+            @KeyChainExternalSignatureRequest.SignatureAlgorithm int algorithm) {
+        switch (algorithm) {
+            case KeyChainExternalSignatureRequest.SIGNATURE_ALGORITHM_RSA_PKCS1_SHA256:
+                return IExternalKeyProviderService.SIGNATURE_ALGORITHM_RSA_PKCS1_SHA256;
+            case KeyChainExternalSignatureRequest.SIGNATURE_ALGORITHM_RSA_PSS_SHA256:
+                return IExternalKeyProviderService.SIGNATURE_ALGORITHM_RSA_PSS_SHA256;
+            case KeyChainExternalSignatureRequest.SIGNATURE_ALGORITHM_ECDSA_P384_SHA256:
+                return IExternalKeyProviderService.SIGNATURE_ALGORITHM_ECDSA_P384_SHA256;
+            case KeyChainExternalSignatureRequest.SIGNATURE_ALGORITHM_ECDSA_P384_SHA384:
+                return IExternalKeyProviderService.SIGNATURE_ALGORITHM_ECDSA_P384_SHA384;
+            default:
+                throw new IllegalArgumentException("Unknown external signature algorithm");
+        }
+    }
+
+    @KeyChainExternalSignatureResult.Failure
+    private static int mapFailure(@ExternalKeyProviderResult.Failure int failure) {
+        switch (failure) {
+            case ExternalKeyProviderResult.FAILURE_INVALID_REQUEST:
+                return KeyChainExternalSignatureResult.FAILURE_INVALID_REQUEST;
+            case ExternalKeyProviderResult.FAILURE_PROVIDER_UNAVAILABLE:
+                return KeyChainExternalSignatureResult.FAILURE_PROVIDER_UNAVAILABLE;
+            case ExternalKeyProviderResult.FAILURE_PROVIDER_GENERATION_CHANGED:
+                return KeyChainExternalSignatureResult.FAILURE_PROVIDER_GENERATION_CHANGED;
+            case ExternalKeyProviderResult.FAILURE_USER_CANCELLED:
+                return KeyChainExternalSignatureResult.FAILURE_USER_CANCELLED;
+            case ExternalKeyProviderResult.FAILURE_USER_TIMED_OUT:
+                return KeyChainExternalSignatureResult.FAILURE_USER_TIMED_OUT;
+            case ExternalKeyProviderResult.FAILURE_CALLER_INTERRUPTED:
+                return KeyChainExternalSignatureResult.FAILURE_CALLER_INTERRUPTED;
+            case ExternalKeyProviderResult.FAILURE_SIGNING_FAILED:
+                return KeyChainExternalSignatureResult.FAILURE_SIGNING_FAILED;
+            case ExternalKeyProviderResult.FAILURE_INTERNAL_ERROR:
+                return KeyChainExternalSignatureResult.FAILURE_INTERNAL_ERROR;
+            case ExternalKeyProviderResult.FAILURE_NONE:
+            default:
+                return KeyChainExternalSignatureResult.FAILURE_INTERNAL_ERROR;
+        }
+    }
+
+    @NonNull
+    private static KeyChainExternalSignatureResult failure(
+            @KeyChainExternalSignatureResult.Failure int failure) {
+        return KeyChainExternalSignatureResult.failure(failure);
+    }
+
+    private static void clear(@Nullable byte[] value) {
+        if (value != null) {
+            Arrays.fill(value, CLEARED_BYTE);
+        }
+    }
+}
