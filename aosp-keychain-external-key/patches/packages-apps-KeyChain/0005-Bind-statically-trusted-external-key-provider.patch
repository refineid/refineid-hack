 }
diff --git a/src/com/android/keychain/TrustedExternalKeyProviderConnection.java b/src/com/android/keychain/TrustedExternalKeyProviderConnection.java
new file mode 100644
index 0000000..eaeed3a
--- /dev/null
+++ b/src/com/android/keychain/TrustedExternalKeyProviderConnection.java
@@ -0,0 +1,342 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.keychain;
+
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.ServiceConnection;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.content.pm.ServiceInfo;
+import android.os.IBinder;
+import android.os.Looper;
+import android.os.Process;
+import android.os.RemoteException;
+import android.os.SystemClock;
+import android.os.UserHandle;
+
+import com.android.internal.annotations.VisibleForTesting;
+import com.android.keychain.external.ExternalKeyProviderContract;
+import com.android.keychain.external.IExternalKeyProviderService;
+
+import java.util.Objects;
+
+/** Lifecycle and install-time trust checks for the one configured provider component. */
+final class TrustedExternalKeyProviderConnection
+        implements BoundExternalKeyProvider.Connection, ServiceConnection {
+    private static final long NO_PACKAGE_MANAGER_FLAGS = 0L;
+    private static final int NO_BINDER_FLAGS = 0;
+    private static final int MILLISECONDS_PER_SECOND = 1_000;
+    private static final int CONNECTION_TIMEOUT_SECONDS = 5;
+    private static final long CONNECTION_TIMEOUT_MILLISECONDS =
+            CONNECTION_TIMEOUT_SECONDS * MILLISECONDS_PER_SECOND;
+    private static final long NO_WAIT_MILLISECONDS = 0L;
+    private static final int BIND_FLAGS =
+            Context.BIND_AUTO_CREATE | Context.BIND_ALLOW_BACKGROUND_ACTIVITY_STARTS;
+
+    private final @NonNull Context mContext;
+    private final Object mLock = new Object();
+
+    private boolean mClosed;
+    private boolean mBindingInProgress;
+    private boolean mBound;
+    private @Nullable IBinder mServiceBinder;
+    private @Nullable IBinder.DeathRecipient mDeathRecipient;
+    private @Nullable IExternalKeyProviderService mService;
+
+    @NonNull
+    static TrustedExternalKeyProviderConnection create(@NonNull Context context) {
+        Context applicationContext = Objects.requireNonNull(context).getApplicationContext();
+        TrustedExternalKeyProviderConnection connection =
+                new TrustedExternalKeyProviderConnection(
+                        applicationContext == null ? context : applicationContext);
+        connection.ensureBound();
+        return connection;
+    }
+
+    private TrustedExternalKeyProviderConnection(@NonNull Context context) {
+        mContext = context;
+    }
+
+    @Override
+    @Nullable
+    public IExternalKeyProviderService getService() {
+        ensureBound();
+        synchronized (mLock) {
+            if (mService != null || (!mBound && !mBindingInProgress) || mClosed || isMainThread()) {
+                return mService;
+            }
+
+            long deadline = SystemClock.elapsedRealtime() + CONNECTION_TIMEOUT_MILLISECONDS;
+            long remaining = CONNECTION_TIMEOUT_MILLISECONDS;
+            while (mService == null
+                    && (mBound || mBindingInProgress)
+                    && !mClosed
+                    && remaining > NO_WAIT_MILLISECONDS) {
+                try {
+                    mLock.wait(remaining);
+                } catch (InterruptedException exception) {
+                    Thread.currentThread().interrupt();
+                    return null;
+                }
+                remaining = deadline - SystemClock.elapsedRealtime();
+            }
+            return mService;
+        }
+    }
+
+    @Override
+    public void onServiceConnected(ComponentName name, IBinder binder) {
+        if (!ExternalKeyProviderContract.PROVIDER_COMPONENT.equals(name)
+                || binder == null
+                || !isTrustedInstalledProvider()) {
+            rejectBinding();
+            return;
+        }
+
+        IExternalKeyProviderService service = IExternalKeyProviderService.Stub.asInterface(binder);
+        IBinder.DeathRecipient deathRecipient = () -> clearService(binder);
+        try {
+            binder.linkToDeath(deathRecipient, NO_BINDER_FLAGS);
+        } catch (RemoteException exception) {
+            clearService(binder);
+            return;
+        }
+
+        IBinder previousBinder;
+        IBinder.DeathRecipient previousDeathRecipient;
+        boolean reject;
+        synchronized (mLock) {
+            reject = mClosed || (!mBound && !mBindingInProgress);
+            if (reject) {
+                previousBinder = null;
+                previousDeathRecipient = null;
+            } else {
+                previousBinder = mServiceBinder;
+                previousDeathRecipient = mDeathRecipient;
+                mServiceBinder = binder;
+                mDeathRecipient = deathRecipient;
+                mService = service;
+                mLock.notifyAll();
+            }
+        }
+        unlinkDeathRecipient(previousBinder, previousDeathRecipient);
+        if (reject) {
+            unlinkDeathRecipient(binder, deathRecipient);
+        }
+    }
+
+    @Override
+    public void onServiceDisconnected(ComponentName name) {
+        if (ExternalKeyProviderContract.PROVIDER_COMPONENT.equals(name)) {
+            clearService(null);
+        }
+    }
+
+    @Override
+    public void onBindingDied(ComponentName name) {
+        if (!ExternalKeyProviderContract.PROVIDER_COMPONENT.equals(name)) {
+            return;
+        }
+        boolean wasBound = detachBinding();
+        if (wasBound) {
+            unbindSafely();
+        }
+        ensureBound();
+    }
+
+    @Override
+    public void onNullBinding(ComponentName name) {
+        if (!ExternalKeyProviderContract.PROVIDER_COMPONENT.equals(name)) {
+            return;
+        }
+        boolean wasBound = detachBinding();
+        if (wasBound) {
+            unbindSafely();
+        }
+    }
+
+    @Override
+    public void close() {
+        boolean wasBound;
+        IBinder binder;
+        IBinder.DeathRecipient deathRecipient;
+        synchronized (mLock) {
+            if (mClosed) {
+                return;
+            }
+            mClosed = true;
+            wasBound = mBound;
+            mBound = false;
+            binder = mServiceBinder;
+            deathRecipient = mDeathRecipient;
+            mServiceBinder = null;
+            mDeathRecipient = null;
+            mService = null;
+            mLock.notifyAll();
+        }
+        unlinkDeathRecipient(binder, deathRecipient);
+        if (wasBound) {
+            unbindSafely();
+        }
+    }
+
+    @VisibleForTesting
+    static boolean isTrustedProvider(@NonNull ServiceInfo serviceInfo, int signatureCheckResult) {
+        ApplicationInfo applicationInfo = serviceInfo.applicationInfo;
+        if (applicationInfo == null
+                || !ExternalKeyProviderContract.PROVIDER_COMPONENT
+                        .getPackageName()
+                        .equals(serviceInfo.packageName)
+                || !ExternalKeyProviderContract.PROVIDER_COMPONENT
+                        .getPackageName()
+                        .equals(applicationInfo.packageName)
+                || !ExternalKeyProviderContract.PROVIDER_COMPONENT
+                        .getClassName()
+                        .equals(serviceInfo.name)
+                || !serviceInfo.exported
+                || !serviceInfo.enabled
+                || !applicationInfo.enabled
+                || !ExternalKeyProviderContract.BIND_PERMISSION.equals(serviceInfo.permission)
+                || !applicationInfo.isSystemApp()
+                || !applicationInfo.isPrivilegedApp()
+                || UserHandle.getAppId(applicationInfo.uid) < Process.FIRST_APPLICATION_UID) {
+            return false;
+        }
+        return signatureCheckResult == PackageManager.SIGNATURE_MATCH;
+    }
+
+    private void ensureBound() {
+        synchronized (mLock) {
+            if (mClosed || mBound || mBindingInProgress) {
+                return;
+            }
+            mBindingInProgress = true;
+        }
+
+        boolean bound = false;
+        try {
+            if (isTrustedInstalledProvider()) {
+                Intent intent =
+                        new Intent(IExternalKeyProviderService.class.getName())
+                                .setComponent(ExternalKeyProviderContract.PROVIDER_COMPONENT);
+                bound = mContext.bindService(intent, this, BIND_FLAGS);
+            }
+        } catch (RuntimeException exception) {
+            bound = false;
+        }
+
+        boolean unbind;
+        synchronized (mLock) {
+            mBindingInProgress = false;
+            unbind = mClosed && bound;
+            if (!mClosed) {
+                mBound = bound;
+            }
+            mLock.notifyAll();
+        }
+        if (unbind) {
+            unbindSafely();
+        }
+    }
+
+    private boolean isTrustedInstalledProvider() {
+        try {
+            PackageManager packageManager = mContext.getPackageManager();
+            ServiceInfo serviceInfo =
+                    packageManager.getServiceInfo(
+                            ExternalKeyProviderContract.PROVIDER_COMPONENT,
+                            PackageManager.ComponentInfoFlags.of(NO_PACKAGE_MANAGER_FLAGS));
+            int signatureCheckResult =
+                    packageManager.checkSignatures(
+                            mContext.getPackageName(),
+                            ExternalKeyProviderContract.PROVIDER_COMPONENT.getPackageName());
+            return isTrustedProvider(serviceInfo, signatureCheckResult);
+        } catch (PackageManager.NameNotFoundException | RuntimeException exception) {
+            return false;
+        }
+    }
+
+    private boolean detachBinding() {
+        IBinder binder;
+        IBinder.DeathRecipient deathRecipient;
+        boolean wasBound;
+        synchronized (mLock) {
+            wasBound = mBound;
+            mBound = false;
+            binder = mServiceBinder;
+            deathRecipient = mDeathRecipient;
+            mServiceBinder = null;
+            mDeathRecipient = null;
+            mService = null;
+            mLock.notifyAll();
+        }
+        unlinkDeathRecipient(binder, deathRecipient);
+        return wasBound;
+    }
+
+    private void rejectBinding() {
+        boolean wasBound = detachBinding();
+        if (wasBound) {
+            unbindSafely();
+        }
+    }
+
+    private void clearService(@Nullable IBinder expectedBinder) {
+        IBinder binder;
+        IBinder.DeathRecipient deathRecipient;
+        synchronized (mLock) {
+            if (expectedBinder != null && expectedBinder != mServiceBinder) {
+                return;
+            }
+            binder = mServiceBinder;
+            deathRecipient = mDeathRecipient;
+            mServiceBinder = null;
+            mDeathRecipient = null;
+            mService = null;
+            mLock.notifyAll();
+        }
+        unlinkDeathRecipient(binder, deathRecipient);
+    }
+
+    private void unbindSafely() {
+        try {
+            mContext.unbindService(this);
+        } catch (RuntimeException exception) {
+            // A racing service teardown is already an unavailable state.
+        }
+    }
+
+    private static void unlinkDeathRecipient(
+            @Nullable IBinder binder, @Nullable IBinder.DeathRecipient deathRecipient) {
+        if (binder != null && deathRecipient != null) {
+            try {
+                binder.unlinkToDeath(deathRecipient, NO_BINDER_FLAGS);
+            } catch (RuntimeException exception) {
+                // Binder death and teardown are already unavailable states.
+            }
+        }
+    }
+
+    private static boolean isMainThread() {
+        Looper mainLooper = Looper.getMainLooper();
+        return mainLooper != null && Looper.myLooper() == mainLooper;
+    }
+}
