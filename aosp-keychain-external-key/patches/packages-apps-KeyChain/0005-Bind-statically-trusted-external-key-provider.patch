+
+package com.android.keychain.external;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertThrows;
+import static org.junit.Assert.assertTrue;
+
+import android.os.Parcel;
+import android.os.Parcelable;
+
+import androidx.test.runner.AndroidJUnit4;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+
+@RunWith(AndroidJUnit4.class)
+public final class ExternalKeyProviderParcelTest {
+    private static final String SYNTHETIC_LEAF_TEXT = "synthetic-leaf";
+    private static final String SYNTHETIC_CHAIN_TEXT = "synthetic-chain";
+    private static final String SYNTHETIC_SIGNATURE_TEXT = "synthetic-signature";
+    private static final byte[] SYNTHETIC_LEAF =
+            SYNTHETIC_LEAF_TEXT.getBytes(StandardCharsets.US_ASCII);
+    private static final byte[] SYNTHETIC_CHAIN =
+            SYNTHETIC_CHAIN_TEXT.getBytes(StandardCharsets.US_ASCII);
+    private static final byte[] SYNTHETIC_SIGNATURE =
+            SYNTHETIC_SIGNATURE_TEXT.getBytes(StandardCharsets.US_ASCII);
+    private static final long SYNTHETIC_PROVIDER_GENERATION = 7L;
+    private static final long NO_PROVIDER_GENERATION = 0L;
+    private static final int UNKNOWN_FAILURE = Integer.MAX_VALUE;
+    private static final int UNKNOWN_WIRE_VERSION = Integer.MAX_VALUE;
+    private static final int PARCEL_START_POSITION = 0;
+    private static final int NO_REMAINING_PARCEL_BYTES = 0;
+    private static final int EMPTY_ARRAY_LENGTH_BYTES = 0;
+    private static final int RETURN_VALUE_WRITE_FLAGS = Parcelable.PARCELABLE_WRITE_RETURN_VALUE;
+    private static final byte MODIFIED_BYTE = 0x31;
+
+    private static final int[] COARSE_FAILURES = {
+        ExternalKeyProviderResult.FAILURE_INVALID_REQUEST,
+        ExternalKeyProviderResult.FAILURE_PROVIDER_UNAVAILABLE,
+        ExternalKeyProviderResult.FAILURE_PROVIDER_GENERATION_CHANGED,
+        ExternalKeyProviderResult.FAILURE_USER_CANCELLED,
+        ExternalKeyProviderResult.FAILURE_USER_TIMED_OUT,
+        ExternalKeyProviderResult.FAILURE_CALLER_INTERRUPTED,
+        ExternalKeyProviderResult.FAILURE_SIGNING_FAILED,
+        ExternalKeyProviderResult.FAILURE_INTERNAL_ERROR
+    };
+
+    @Test
+    public void identityRoundTripsAndDefensivelyCopiesCertificates() {
+        byte[] leaf = SYNTHETIC_LEAF.clone();
+        byte[] chain = SYNTHETIC_CHAIN.clone();
+        ExternalKeyProviderIdentity identity =
+                ExternalKeyProviderIdentity.create(leaf, chain, SYNTHETIC_PROVIDER_GENERATION);
+        Arrays.fill(leaf, MODIFIED_BYTE);
+        Arrays.fill(chain, MODIFIED_BYTE);
+
+        ExternalKeyProviderIdentity restored = identityParcelRoundTrip(identity);
+
+        assertArrayEquals(SYNTHETIC_LEAF, restored.copyLeafCertificate());
+        assertArrayEquals(SYNTHETIC_CHAIN, restored.copyCaCertificates());
+        assertEquals(SYNTHETIC_PROVIDER_GENERATION, restored.getProviderGeneration());
+        assertFalse(identity.toString().contains(SYNTHETIC_LEAF_TEXT));
+        assertFalse(identity.toString().contains(SYNTHETIC_CHAIN_TEXT));
+        identity.close();
+        restored.close();
+    }
+
+    @Test
+    public void identityRejectsEmptyCertificatesAndNonpositiveGeneration() {
+        assertThrows(
+                IllegalArgumentException.class,
+                () ->
+                        ExternalKeyProviderIdentity.create(
+                                new byte[EMPTY_ARRAY_LENGTH_BYTES],
+                                null,
+                                SYNTHETIC_PROVIDER_GENERATION));
+        assertThrows(
+                IllegalArgumentException.class,
+                () ->
+                        ExternalKeyProviderIdentity.create(
+                                SYNTHETIC_LEAF,
+                                new byte[EMPTY_ARRAY_LENGTH_BYTES],
+                                SYNTHETIC_PROVIDER_GENERATION));
+        assertThrows(
+                IllegalArgumentException.class,
+                () ->
+                        ExternalKeyProviderIdentity.create(
+                                SYNTHETIC_LEAF, null, NO_PROVIDER_GENERATION));
+    }
+
+    @Test
+    public void returnedIdentityClearsItsSendingSideCertificateBytes() {
+        ExternalKeyProviderIdentity identity =
+                ExternalKeyProviderIdentity.create(
+                        SYNTHETIC_LEAF, SYNTHETIC_CHAIN, SYNTHETIC_PROVIDER_GENERATION);
+        Parcel parcel = Parcel.obtain();
+        try {
+            identity.writeToParcel(parcel, RETURN_VALUE_WRITE_FLAGS);
+
+            assertThrows(IllegalStateException.class, identity::copyLeafCertificate);
+            assertThrows(IllegalStateException.class, identity::copyCaCertificates);
+        } finally {
+            parcel.recycle();
+            identity.close();
+        }
+    }
+
+    @Test
+    public void successAndEveryCoarseFailureRoundTrip() {
+        ExternalKeyProviderResult success = ExternalKeyProviderResult.success(SYNTHETIC_SIGNATURE);
+        ExternalKeyProviderResult restoredSuccess = resultParcelRoundTrip(success);
+        assertTrue(restoredSuccess.isSuccess());
+        assertArrayEquals(SYNTHETIC_SIGNATURE, restoredSuccess.copySignature());
+        assertFalse(success.toString().contains(SYNTHETIC_SIGNATURE_TEXT));
+        success.close();
+        restoredSuccess.close();
+
+        for (int failure : COARSE_FAILURES) {
+            ExternalKeyProviderResult result = ExternalKeyProviderResult.failure(failure);
+            ExternalKeyProviderResult restored = resultParcelRoundTrip(result);
+            assertFalse(restored.isSuccess());
+            assertEquals(failure, restored.getFailure());
+            assertThrows(IllegalStateException.class, restored::copySignature);
+            result.close();
+            restored.close();
+        }
+    }
+
+    @Test
+    public void resultRejectsEmptySuccessNoneFailureAndUnknownFailure() {
+        assertThrows(
+                IllegalArgumentException.class,
+                () -> ExternalKeyProviderResult.success(new byte[EMPTY_ARRAY_LENGTH_BYTES]));
+        assertThrows(
+                IllegalArgumentException.class,
+                () -> ExternalKeyProviderResult.failure(ExternalKeyProviderResult.FAILURE_NONE));
+        assertThrows(
+                IllegalArgumentException.class,
+                () -> ExternalKeyProviderResult.failure(UNKNOWN_FAILURE));
+    }
+
+    @Test
+    public void returnedResultClearsItsSendingSideSignatureBytes() {
+        ExternalKeyProviderResult result = ExternalKeyProviderResult.success(SYNTHETIC_SIGNATURE);
+        Parcel parcel = Parcel.obtain();
+        try {
+            result.writeToParcel(parcel, RETURN_VALUE_WRITE_FLAGS);
+
+            assertThrows(IllegalStateException.class, result::copySignature);
+        } finally {
+            parcel.recycle();
+            result.close();
+        }
+    }
+
+    @Test
+    public void unknownParcelableVersionsAreRejected() {
+        Parcel identityParcel = Parcel.obtain();
+        try {
+            identityParcel.writeInt(UNKNOWN_WIRE_VERSION);
+            identityParcel.setDataPosition(PARCEL_START_POSITION);
+            assertThrows(
+                    IllegalArgumentException.class,
+                    () -> ExternalKeyProviderIdentity.CREATOR.createFromParcel(identityParcel));
+        } finally {
+            identityParcel.recycle();
+        }
+
+        Parcel resultParcel = Parcel.obtain();
+        try {
+            resultParcel.writeInt(UNKNOWN_WIRE_VERSION);
+            resultParcel.setDataPosition(PARCEL_START_POSITION);
+            assertThrows(
+                    IllegalArgumentException.class,
+                    () -> ExternalKeyProviderResult.CREATOR.createFromParcel(resultParcel));
+        } finally {
+            resultParcel.recycle();
+        }
+    }
+
+    private static ExternalKeyProviderIdentity identityParcelRoundTrip(
+            ExternalKeyProviderIdentity identity) {
+        Parcel parcel = Parcel.obtain();
+        try {
+            identity.writeToParcel(parcel, identity.describeContents());
+            parcel.setDataPosition(PARCEL_START_POSITION);
+            ExternalKeyProviderIdentity restored =
+                    ExternalKeyProviderIdentity.CREATOR.createFromParcel(parcel);
+            assertEquals(NO_REMAINING_PARCEL_BYTES, parcel.dataAvail());
+            return restored;
+        } finally {
+            parcel.recycle();
+        }
+    }
+
+    private static ExternalKeyProviderResult resultParcelRoundTrip(
+            ExternalKeyProviderResult result) {
+        Parcel parcel = Parcel.obtain();
+        try {
+            result.writeToParcel(parcel, result.describeContents());
+            parcel.setDataPosition(PARCEL_START_POSITION);
+            ExternalKeyProviderResult restored =
+                    ExternalKeyProviderResult.CREATOR.createFromParcel(parcel);
+            assertEquals(NO_REMAINING_PARCEL_BYTES, parcel.dataAvail());
+            return restored;
+        } finally {
+            parcel.recycle();
+        }
+    }
+}
