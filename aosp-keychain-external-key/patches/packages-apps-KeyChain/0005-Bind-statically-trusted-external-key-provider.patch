+            KeyChainExternalSignatureResult.FAILURE_CALLER_INTERRUPTED
+        },
+        {
+            ExternalKeyProviderResult.FAILURE_SIGNING_FAILED,
+            KeyChainExternalSignatureResult.FAILURE_SIGNING_FAILED
+        },
+        {
+            ExternalKeyProviderResult.FAILURE_INTERNAL_ERROR,
+            KeyChainExternalSignatureResult.FAILURE_INTERNAL_ERROR
+        }
+    };
+
+    @Test
+    public void validIdentityAndSignatureCrossTheVersionedBoundary() throws Exception {
+        PrivateKeyEntry keyEntry = syntheticRsaKeyEntry();
+        byte[] leafCertificate = keyEntry.getCertificate().getEncoded();
+        FakeService service = new FakeService();
+        service.mIdentity =
+                ExternalKeyProviderIdentity.create(
+                        leafCertificate, null, SYNTHETIC_PROVIDER_GENERATION);
+        byte[] signature = syntheticRsaSignature(keyEntry);
+        service.mNextResult = ExternalKeyProviderResult.success(signature);
+        FakeConnection connection = new FakeConnection(service);
+        BoundExternalKeyProvider provider = new BoundExternalKeyProvider(connection);
+
+        ExternalKeyIdentity identity = provider.getActiveIdentity();
+        assertThat(identity).isNotNull();
+        assertThat(identity.copyLeafCertificate()).isEqualTo(leafCertificate);
+        assertThat(identity.getProviderGeneration()).isEqualTo(SYNTHETIC_PROVIDER_GENERATION);
+
+        byte[] digest = syntheticDigest();
+        ExternalKeyCaller caller =
+                new ExternalKeyCaller(
+                        SYNTHETIC_CALLER_UID,
+                        new String[] {SYNTHETIC_CALLER_HELPER_PACKAGE, SYNTHETIC_CALLER_PACKAGE});
+        try (KeyChainExternalSignatureRequest request = newRequest(digest);
+                KeyChainExternalSignatureResult result = provider.sign(caller, request)) {
+            assertThat(result.isSuccess()).isTrue();
+            assertThat(result.copySignature()).isEqualTo(signature);
+            assertThat(service.mObservedCallerUid).isEqualTo(SYNTHETIC_CALLER_UID);
+            assertThat(service.mObservedCallerPackages)
+                    .asList()
+                    .containsExactly(SYNTHETIC_CALLER_PACKAGE, SYNTHETIC_CALLER_HELPER_PACKAGE)
+                    .inOrder();
+            assertThat(service.mObservedAlias).isEqualTo(ExternalKeyManager.KEYCHAIN_ALIAS);
+            assertThat(service.mObservedGeneration).isEqualTo(SYNTHETIC_PROVIDER_GENERATION);
+            assertThat(service.mObservedAlgorithm)
+                    .isEqualTo(
+                            IExternalKeyProviderService
+                                    .SIGNATURE_ALGORITHM_RSA_PKCS1_SHA256);
+            assertThat(service.mObservedDigest).isEqualTo(digest);
+            assertThat(service.mObservedOperationToken).isEqualTo(request.getOperationToken());
+        } finally {
+            Arrays.fill(digest, CLEARED_BYTE);
+            Arrays.fill(signature, CLEARED_BYTE);
+            Arrays.fill(leafCertificate, CLEARED_BYTE);
+            provider.close();
+        }
+        assertThat(connection.mCloseCallCount).isEqualTo(SINGLE_CLOSE_CALL);
+    }
+
+    @Test
+    public void everyFrameworkAlgorithmMapsToTheNamedProviderAlgorithm() {
+        for (int[] mapping : ALGORITHM_MAPPINGS) {
+            assertThat(
+                            BoundExternalKeyProvider.toProviderAlgorithm(
+                                    mapping[FRAMEWORK_ALGORITHM_INDEX]))
+                    .isEqualTo(mapping[PROVIDER_ALGORITHM_INDEX]);
+        }
+        assertThrows(
+                IllegalArgumentException.class,
+                () -> BoundExternalKeyProvider.toProviderAlgorithm(UNKNOWN_SIGNATURE_ALGORITHM));
+    }
+
+    @Test
+    public void incompatibleProtocolNeverReceivesIdentityOrSigningData() throws Exception {
+        FakeService service = new FakeService();
+        service.mProtocolVersion =
+                IExternalKeyProviderService.PROTOCOL_VERSION + PROTOCOL_VERSION_INCREMENT;
+        BoundExternalKeyProvider provider =
+                new BoundExternalKeyProvider(new FakeConnection(service));
+        byte[] digest = syntheticDigest();
+
+        assertThat(provider.getActiveIdentity()).isNull();
+        try (KeyChainExternalSignatureRequest request = newRequest(digest);
+                KeyChainExternalSignatureResult result =
+                        provider.sign(syntheticCaller(), request)) {
+            assertThat(result.getFailure())
+                    .isEqualTo(KeyChainExternalSignatureResult.FAILURE_PROVIDER_UNAVAILABLE);
+        } finally {
+            Arrays.fill(digest, CLEARED_BYTE);
+            provider.close();
+        }
+        assertThat(service.mIdentityCallCount).isEqualTo(NO_REMOTE_CALLS);
+        assertThat(service.mSignCallCount).isEqualTo(NO_REMOTE_CALLS);
+    }
+
+    @Test
+    public void providerFailuresRemainCoarseAndRemoteDeathIsUnavailable() throws Exception {
+        FakeService service = new FakeService();
+        BoundExternalKeyProvider provider =
+                new BoundExternalKeyProvider(new FakeConnection(service));
+        byte[] digest = syntheticDigest();
+
+        try (KeyChainExternalSignatureRequest request = newRequest(digest);
+                KeyChainExternalSignatureResult result =
+                        provider.sign(syntheticCaller(), request)) {
+            assertThat(result.getFailure())
+                    .isEqualTo(KeyChainExternalSignatureResult.FAILURE_INTERNAL_ERROR);
+        }
+
+        service.mNextResult =
+                ExternalKeyProviderResult.failure(ExternalKeyProviderResult.FAILURE_USER_CANCELLED);
+        try (KeyChainExternalSignatureRequest request = newRequest(digest);
+                KeyChainExternalSignatureResult result =
+                        provider.sign(syntheticCaller(), request)) {
+            assertThat(result.getFailure())
+                    .isEqualTo(KeyChainExternalSignatureResult.FAILURE_USER_CANCELLED);
+        }
+
+        service.mThrowRemoteException = true;
+        try (KeyChainExternalSignatureRequest request = newRequest(digest);
+                KeyChainExternalSignatureResult result =
+                        provider.sign(syntheticCaller(), request)) {
+            assertThat(result.getFailure())
+                    .isEqualTo(KeyChainExternalSignatureResult.FAILURE_PROVIDER_UNAVAILABLE);
+        } finally {
+            Arrays.fill(digest, CLEARED_BYTE);
+            provider.close();
+        }
+    }
+
+    @Test
+    public void everyProviderFailureMapsToTheMatchingKeyChainFailure() throws Exception {
+        FakeService service = new FakeService();
+        BoundExternalKeyProvider provider =
+                new BoundExternalKeyProvider(new FakeConnection(service));
+        byte[] digest = syntheticDigest();
+        try {
+            for (int[] mapping : FAILURE_MAPPINGS) {
+                service.mNextResult =
+                        ExternalKeyProviderResult.failure(mapping[PROVIDER_FAILURE_INDEX]);
+                try (KeyChainExternalSignatureRequest request = newRequest(digest);
+                        KeyChainExternalSignatureResult result =
+                                provider.sign(syntheticCaller(), request)) {
+                    assertThat(result.getFailure()).isEqualTo(mapping[KEYCHAIN_FAILURE_INDEX]);
+                }
+            }
+        } finally {
+            Arrays.fill(digest, CLEARED_BYTE);
+            provider.close();
+        }
+    }
+
+    @Test
+    public void closeIsIdempotentAndMakesTheProviderUnavailable() throws Exception {
+        FakeConnection connection = new FakeConnection(new FakeService());
+        BoundExternalKeyProvider provider = new BoundExternalKeyProvider(connection);
+
+        provider.close();
+        provider.close();
+
+        assertThat(provider.getActiveIdentity()).isNull();
+        assertThat(connection.mCloseCallCount).isEqualTo(SINGLE_CLOSE_CALL);
+        assertThat(provider.toString()).doesNotContain(SYNTHETIC_CALLER_PACKAGE);
+    }
+
+    @Test
+    public void trustRequiresTheExactPrivilegedSystemServiceAndMatchingSignature() {
+        ServiceInfo trusted = trustedServiceInfo();
+        assertThat(
+                        TrustedExternalKeyProviderConnection.isTrustedProvider(
+                                trusted, PackageManager.SIGNATURE_MATCH))
+                .isTrue();
+
+        ServiceInfo wrongPermission = trustedServiceInfo();
+        wrongPermission.permission = SYNTHETIC_UNTRUSTED_PERMISSION;
+        assertThat(
+                        TrustedExternalKeyProviderConnection.isTrustedProvider(
+                                wrongPermission, PackageManager.SIGNATURE_MATCH))
+                .isFalse();
+
+        ServiceInfo notPrivileged = trustedServiceInfo();
+        notPrivileged.applicationInfo.privateFlags &= ~ApplicationInfo.PRIVATE_FLAG_PRIVILEGED;
+        assertThat(
+                        TrustedExternalKeyProviderConnection.isTrustedProvider(
+                                notPrivileged, PackageManager.SIGNATURE_MATCH))
+                .isFalse();
+
+        ServiceInfo notSystem = trustedServiceInfo();
+        notSystem.applicationInfo.flags &= ~ApplicationInfo.FLAG_SYSTEM;
+        assertThat(
+                        TrustedExternalKeyProviderConnection.isTrustedProvider(
+                                notSystem, PackageManager.SIGNATURE_MATCH))
+                .isFalse();
+
+        ServiceInfo wrongApplicationPackage = trustedServiceInfo();
+        wrongApplicationPackage.applicationInfo.packageName = SYNTHETIC_UNTRUSTED_PACKAGE;
+        assertThat(
+                        TrustedExternalKeyProviderConnection.isTrustedProvider(
+                                wrongApplicationPackage, PackageManager.SIGNATURE_MATCH))
+                .isFalse();
+
+        ServiceInfo notExported = trustedServiceInfo();
+        notExported.exported = false;
+        assertThat(
+                        TrustedExternalKeyProviderConnection.isTrustedProvider(
+                                notExported, PackageManager.SIGNATURE_MATCH))
+                .isFalse();
+
+        ServiceInfo sharedSystemUid = trustedServiceInfo();
+        sharedSystemUid.applicationInfo.uid = Process.SYSTEM_UID;
+        assertThat(
+                        TrustedExternalKeyProviderConnection.isTrustedProvider(
+                                sharedSystemUid, PackageManager.SIGNATURE_MATCH))
+                .isFalse();
+
+        assertThat(
+                        TrustedExternalKeyProviderConnection.isTrustedProvider(
+                                trusted, PackageManager.SIGNATURE_NO_MATCH))
+                .isFalse();
+    }
+
+    @Test
+    public void providerParcelablesDefensivelyCopyAndSanitizeTheirStringForms() throws Exception {
+        byte[] leafCertificate = syntheticRsaKeyEntry().getCertificate().getEncoded();
+        byte[] retainedLeaf = leafCertificate.clone();
+        ExternalKeyProviderIdentity identity =
+                ExternalKeyProviderIdentity.create(
+                        leafCertificate, null, SYNTHETIC_PROVIDER_GENERATION);
+        Arrays.fill(leafCertificate, CLEARED_BYTE);
+
+        assertThat(identity.copyLeafCertificate()).isEqualTo(retainedLeaf);
+        assertThat(identity.toString()).doesNotContain(Arrays.toString(retainedLeaf));
+
+        byte[] signature = syntheticRsaSignature(syntheticRsaKeyEntry());
+        byte[] retainedSignature = signature.clone();
+        ExternalKeyProviderResult result = ExternalKeyProviderResult.success(signature);
+        Arrays.fill(signature, CLEARED_BYTE);
+        assertThat(result.copySignature()).isEqualTo(retainedSignature);
+        assertThat(result.toString()).doesNotContain(Arrays.toString(retainedSignature));
+
+        identity.close();
+        result.close();
+        Arrays.fill(retainedLeaf, CLEARED_BYTE);
+        Arrays.fill(retainedSignature, CLEARED_BYTE);
+    }
+
+    private static ExternalKeyCaller syntheticCaller() {
+        return new ExternalKeyCaller(SYNTHETIC_CALLER_UID, new String[] {SYNTHETIC_CALLER_PACKAGE});
+    }
+
+    private static byte[] syntheticDigest() {
+        byte[] digest =
+                new byte
+                        [KeyChainExternalSignatureRequest.getDigestLengthBytes(
+                                KeyChainExternalSignatureRequest
+                                        .SIGNATURE_ALGORITHM_RSA_PKCS1_SHA256)];
+        Arrays.fill(digest, SYNTHETIC_DIGEST_FILL);
+        return digest;
+    }
+
+    private static KeyChainExternalSignatureRequest newRequest(byte[] digest) {
+        return KeyChainExternalSignatureRequest.create(
+                ExternalKeyManager.KEYCHAIN_ALIAS,
+                KeyChainExternalSignatureRequest.SIGNATURE_ALGORITHM_RSA_PKCS1_SHA256,
+                digest,
+                SYNTHETIC_PROVIDER_GENERATION);
+    }
+
+    private static PrivateKeyEntry syntheticRsaKeyEntry() {
+        return TestKeyStore.getClientCertificate()
+                .getPrivateKey(RSA_KEY_ALGORITHM, RSA_KEY_ALGORITHM);
+    }
+
+    private static byte[] syntheticRsaSignature(PrivateKeyEntry keyEntry) {
+        int modulusLengthBits =
+                ((RSAKey) keyEntry.getCertificate().getPublicKey()).getModulus().bitLength();
+        int modulusLengthBytes = (modulusLengthBits + BITS_TO_BYTES_ROUNDING_OFFSET) / Byte.SIZE;
+        byte[] signature = new byte[modulusLengthBytes];
+        Arrays.fill(signature, SYNTHETIC_SIGNATURE_FILL);
+        return signature;
+    }
+
+    private static ServiceInfo trustedServiceInfo() {
+        ApplicationInfo applicationInfo = new ApplicationInfo();
+        applicationInfo.packageName =
+                ExternalKeyProviderContract.PROVIDER_COMPONENT.getPackageName();
+        applicationInfo.enabled = true;
+        applicationInfo.flags = ApplicationInfo.FLAG_SYSTEM;
+        applicationInfo.privateFlags = ApplicationInfo.PRIVATE_FLAG_PRIVILEGED;
+        applicationInfo.uid = Process.FIRST_APPLICATION_UID;
+
+        ServiceInfo serviceInfo = new ServiceInfo();
+        serviceInfo.applicationInfo = applicationInfo;
+        serviceInfo.packageName = ExternalKeyProviderContract.PROVIDER_COMPONENT.getPackageName();
+        serviceInfo.name = ExternalKeyProviderContract.PROVIDER_COMPONENT.getClassName();
+        serviceInfo.permission = ExternalKeyProviderContract.BIND_PERMISSION;
+        serviceInfo.enabled = true;
+        serviceInfo.exported = true;
+        return serviceInfo;
+    }
+
+    private static final class FakeConnection implements BoundExternalKeyProvider.Connection {
+        private final IExternalKeyProviderService mService;
+        private int mCloseCallCount;
+
+        FakeConnection(IExternalKeyProviderService service) {
+            mService = service;
+        }
+
+        @Override
+        public IExternalKeyProviderService getService() {
+            return mService;
+        }
+
+        @Override
+        public void close() {
+            mCloseCallCount++;
+        }
+    }
+
+    private static final class FakeService implements IExternalKeyProviderService {
+        private int mProtocolVersion = IExternalKeyProviderService.PROTOCOL_VERSION;
+        private ExternalKeyProviderIdentity mIdentity;
+        private ExternalKeyProviderResult mNextResult;
+        private boolean mThrowRemoteException;
+        private int mIdentityCallCount;
+        private int mSignCallCount;
+        private int mObservedCallerUid;
+        private String[] mObservedCallerPackages;
+        private String mObservedAlias;
+        private long mObservedGeneration;
+        private int mObservedAlgorithm;
+        private byte[] mObservedDigest;
+        private IBinder mObservedOperationToken;
+
+        @Override
+        public int getProtocolVersion() {
+            return mProtocolVersion;
+        }
+
+        @Override
+        public ExternalKeyProviderIdentity getActiveIdentity() {
+            mIdentityCallCount++;
+            return mIdentity;
+        }
+
+        @Override
+        public ExternalKeyProviderResult sign(
+                int callerUid,
+                String[] callerPackages,
+                String externalAlias,
+                long providerGeneration,
+                int algorithm,
+                byte[] digest,
+                IBinder operationToken)
+                throws RemoteException {
+            mSignCallCount++;
+            if (mThrowRemoteException) {
+                throw new RemoteException("Synthetic provider death");
+            }
+            mObservedCallerUid = callerUid;
+            mObservedCallerPackages = callerPackages.clone();
+            mObservedAlias = externalAlias;
+            mObservedGeneration = providerGeneration;
+            mObservedAlgorithm = algorithm;
+            mObservedDigest = digest.clone();
+            mObservedOperationToken = operationToken;
+            return mNextResult;
+        }
+
+        @Override
+        public boolean removeIdentity(long providerGeneration) {
+            return false;
+        }
+
+        @Override
+        public IBinder asBinder() {
+            return null;
+        }
+    }
+}
