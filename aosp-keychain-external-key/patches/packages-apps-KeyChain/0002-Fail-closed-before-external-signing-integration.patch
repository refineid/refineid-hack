+    @Test
+    public void testExternalSignatureFailsClosedBeforeProviderIntegration() throws RemoteException {
+        int algorithm =
+                KeyChainExternalSignatureRequest.SIGNATURE_ALGORITHM_RSA_PKCS1_SHA256;
+        byte[] digest =
+                new byte[KeyChainExternalSignatureRequest.getDigestLengthBytes(algorithm)];
+        Arrays.fill(digest, SYNTHETIC_DIGEST_FILL);
+
+        try (KeyChainExternalSignatureRequest request =
+                        KeyChainExternalSignatureRequest.create(
+                                SYNTHETIC_EXTERNAL_ALIAS,
+                                algorithm,
+                                digest,
+                                SYNTHETIC_PROVIDER_GENERATION);
+                KeyChainExternalSignatureResult result =
+                        Objects.requireNonNull(
+                                mKeyChainService.requestExternalSignature(request))) {
+            assertThat(result.isSuccess()).isFalse();
+            assertThat(result.getFailure())
+                    .isEqualTo(
+                            KeyChainExternalSignatureResult.FAILURE_PROVIDER_UNAVAILABLE);
+        } finally {
+            Arrays.fill(digest, CLEARED_BYTE);
+        }
+    }
+
+    @Test
+    public void testNullExternalSignatureRequestIsInvalid() throws RemoteException {
+        try (KeyChainExternalSignatureResult result =
+                Objects.requireNonNull(mKeyChainService.requestExternalSignature(null))) {
+            assertThat(result.isSuccess()).isFalse();
+            assertThat(result.getFailure())
+                    .isEqualTo(KeyChainExternalSignatureResult.FAILURE_INVALID_REQUEST);
+        }
+    }
+
