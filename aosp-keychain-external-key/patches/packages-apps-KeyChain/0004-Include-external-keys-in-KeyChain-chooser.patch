+    private static final class KeyChainCertificateSource implements CertificateSource {
+        private static final int LEAF_CERTIFICATE_INDEX = 0;
+        private static final int FIRST_CA_CERTIFICATE_INDEX = LEAF_CERTIFICATE_INDEX + 1;
+        private static final int NO_CERTIFICATES = 0;
+
+        private final Context mContext;
+        private final Map<String, List<X509Certificate>> mCertificateChains = new HashMap<>();
+
+        KeyChainCertificateSource(Context context) {
+            mContext = context.getApplicationContext();
+        }
+
+        @Override
+        @Nullable
+        public X509Certificate getLeafCertificate(String alias) {
+            List<X509Certificate> chain = getCertificateChain(alias);
+            return chain.isEmpty() ? null : chain.get(LEAF_CERTIFICATE_INDEX);
+        }
+
+        @Override
+        @NonNull
+        public List<X509Certificate> getCaCertificates(String alias) {
+            List<X509Certificate> chain = getCertificateChain(alias);
+            if (chain.size() <= FIRST_CA_CERTIFICATE_INDEX) {
+                return Collections.emptyList();
+            }
+            return new ArrayList<>(
+                    chain.subList(FIRST_CA_CERTIFICATE_INDEX, chain.size()));
+        }
+
+        @NonNull
+        private synchronized List<X509Certificate> getCertificateChain(String alias) {
+            List<X509Certificate> cached = mCertificateChains.get(alias);
+            if (cached != null) {
+                return cached;
+            }
+            try {
+                X509Certificate[] chain = KeyChain.getCertificateChain(mContext, alias);
+                if (chain == null || chain.length == NO_CERTIFICATES) {
+                    List<X509Certificate> absent = Collections.emptyList();
+                    mCertificateChains.put(alias, absent);
+                    return absent;
+                }
+                List<X509Certificate> loaded = Collections.unmodifiableList(
+                        new ArrayList<>(Arrays.asList(chain)));
+                mCertificateChains.put(alias, loaded);
+                return loaded;
+            } catch (InterruptedException exception) {
+                Thread.currentThread().interrupt();
+                return Collections.emptyList();
+            } catch (KeyChainException | RuntimeException exception) {
+                return Collections.emptyList();
+            }
+        }
+    }
+
