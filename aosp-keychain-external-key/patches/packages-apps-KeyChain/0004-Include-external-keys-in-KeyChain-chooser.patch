+    @NonNull
+    private static List<String> loadExternalAliases(Context context) {
+        try (KeyChain.KeyChainConnection connection =
+                KeyChain.bind(context.getApplicationContext())) {
+            StringParceledListSlice aliases =
+                    connection.getService().getExternalKeyAliases();
+            if (aliases == null || aliases.getList() == null) {
+                return Collections.emptyList();
+            }
+            return new ArrayList<>(aliases.getList());
+        } catch (InterruptedException exception) {
+            Thread.currentThread().interrupt();
+            return Collections.emptyList();
+        } catch (RemoteException | RuntimeException exception) {
+            return Collections.emptyList();
+        }
+    }
+
+    @VisibleForTesting
+    @NonNull
+    public static List<String> mergeAliases(
+            @NonNull List<String> keyStoreAliases,
+            @NonNull List<String> externalAliases) {
+        Set<String> merged = new LinkedHashSet<>();
+        addValidAliases(merged, keyStoreAliases);
+        addValidAliases(merged, externalAliases);
+        return new ArrayList<>(merged);
+    }
+
+    private static void addValidAliases(
+            @NonNull Set<String> destination, @NonNull List<String> aliases) {
+        for (String alias : aliases) {
+            if (alias != null && !alias.isEmpty()) {
+                destination.add(alias);
+            }
+        }
+    }
+
