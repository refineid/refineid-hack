Subject: [PATCH] Return typed descriptors for KeyChain grants

---
 src/com/android/keychain/KeyChainService.java | 10 +++++++++
 .../tests/BasicKeyChainServiceTest.java       | 22 +++++++++++++++++++
 2 files changed, 32 insertions(+)

diff --git a/src/com/android/keychain/KeyChainService.java b/src/com/android/keychain/KeyChainService.java
index 6686542..80bbc66 100644
--- a/src/com/android/keychain/KeyChainService.java
+++ b/src/com/android/keychain/KeyChainService.java
@@ -43,6 +43,7 @@ import android.security.AppUriAuthenticationPolicy;
 import android.security.CredentialManagementApp;
 import android.security.IKeyChainService;
 import android.security.KeyChain;
+import android.security.KeyChainPrivateKeyDescriptor;
 import android.security.KeyStore2;
 import android.security.keystore.KeyGenParameterSpec;
 import android.security.keystore.KeyProperties;
@@ -256,6 +257,15 @@ public class KeyChainService extends IntentService {
             }
         }
 
+        @Override
+        public KeyChainPrivateKeyDescriptor requestPrivateKeyDescriptor(String alias) {
+            final String keyStoreGrant = requestPrivateKey(alias);
+            if (keyStoreGrant == null) {
+                return null;
+            }
+            return KeyChainPrivateKeyDescriptor.forKeyStoreGrant(keyStoreGrant);
+        }
+
         @Override public byte[] getCertificate(String alias) {
             final CallerIdentity caller = getCaller();
             if (!hasGrant(alias, caller) && !isSystemUid(caller)) {
diff --git a/tests/src/com/android/keychain/tests/BasicKeyChainServiceTest.java b/tests/src/com/android/keychain/tests/BasicKeyChainServiceTest.java
index f3f20db..148da68 100644
--- a/tests/src/com/android/keychain/tests/BasicKeyChainServiceTest.java
+++ b/tests/src/com/android/keychain/tests/BasicKeyChainServiceTest.java
@@ -34,6 +34,8 @@ import android.platform.test.annotations.LargeTest;
 import android.security.Credentials;
 import android.security.IKeyChainService;
 import android.security.KeyChain;
+import android.security.KeyChainException;
+import android.security.KeyChainPrivateKeyDescriptor;
 import android.security.keystore.KeyGenParameterSpec;
 import android.security.keystore.KeyProperties;
 import android.security.keystore.ParcelableKeyGenParameterSpec;
@@ -146,6 +148,26 @@ public class BasicKeyChainServiceTest {
         assertThat(mKeyChainService.requestPrivateKey(ALIAS_1)).isNotNull();
     }
 
+    @Test
+    public void testTypedDescriptorPreservesKeyStoreGrant()
+            throws RemoteException, IOException, CertificateException, KeyChainException,
+                    InterruptedException {
+        removeKeyPair(ALIAS_1);
+        generateRsaKey(ALIAS_1);
+        assertThat(mKeyChainService.requestPrivateKeyDescriptor(ALIAS_1)).isNull();
+        mTestSupportService.grantAppPermission(Process.myUid(), ALIAS_1);
+
+        String legacyGrant = mKeyChainService.requestPrivateKey(ALIAS_1);
+        KeyChainPrivateKeyDescriptor descriptor =
+                mKeyChainService.requestPrivateKeyDescriptor(ALIAS_1);
+
+        assertThat(descriptor).isNotNull();
+        assertThat(descriptor.getType())
+                .isEqualTo(KeyChainPrivateKeyDescriptor.TYPE_KEYSTORE_GRANT);
+        assertThat(descriptor.getKeyStoreGrant()).isEqualTo(legacyGrant);
+        assertThat(KeyChain.getPrivateKey(mContext, ALIAS_1)).isNotNull();
+    }
+
