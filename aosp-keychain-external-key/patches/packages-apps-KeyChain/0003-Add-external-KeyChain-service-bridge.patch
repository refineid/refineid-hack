+
+package com.android.keychain;
+
+import android.annotation.NonNull;
+
+import java.util.Arrays;
+import java.util.Objects;
+
+/** Binder-derived identity of an application using an external KeyChain key. */
+final class ExternalKeyCaller {
+    private static final int MINIMUM_PACKAGE_COUNT = 1;
+
+    private final int mUid;
+    private final @NonNull String[] mPackageNames;
+
+    ExternalKeyCaller(int uid, @NonNull String[] packageNames) {
+        Objects.requireNonNull(packageNames);
+        if (packageNames.length < MINIMUM_PACKAGE_COUNT) {
+            throw new IllegalArgumentException("External-key caller has no installed package");
+        }
+        mPackageNames = packageNames.clone();
+        for (String packageName : mPackageNames) {
+            if (packageName == null || packageName.isEmpty()) {
+                throw new IllegalArgumentException("External-key caller package is empty");
+            }
+        }
+        Arrays.sort(mPackageNames);
+        mUid = uid;
+    }
+
+    int getUid() {
+        return mUid;
+    }
+
+    @NonNull
+    String[] copyPackageNames() {
+        return mPackageNames.clone();
+    }
+
+    @Override
+    public String toString() {
+        return "ExternalKeyCaller{uid=" + mUid + ", packageCount=" + mPackageNames.length + '}';
+    }
+}
