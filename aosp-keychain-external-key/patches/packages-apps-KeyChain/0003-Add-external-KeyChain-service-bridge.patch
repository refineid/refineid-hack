+                KeyChainExternalSignatureResult result = manager.sign(syntheticCaller(), request)) {
+            assertThat(result.getFailure())
+                    .isEqualTo(KeyChainExternalSignatureResult.FAILURE_USER_CANCELLED);
+            assertThat(result.toString()).doesNotContain(ExternalKeyManager.KEYCHAIN_ALIAS);
+        }
+    }
+
+    @Test
+    public void removeRequiresTheExactGenerationToDisappear() throws Exception {
+        FakeProvider provider = new FakeProvider(syntheticRsaIdentity());
+        ExternalKeyManager manager = new ExternalKeyManager(provider);
+
+        assertThat(manager.removeActiveIdentity(ExternalKeyManager.KEYCHAIN_ALIAS)).isTrue();
+        assertThat(provider.mRemovedGeneration).isEqualTo(SYNTHETIC_PROVIDER_GENERATION);
+        assertThat(manager.containsActiveAlias(ExternalKeyManager.KEYCHAIN_ALIAS)).isFalse();
+    }
+
+    @Test
+    public void callerSortsAndDefensivelyCopiesPackages() {
+        String[] packages = {ALTERNATE_CALLER_PACKAGE, SYNTHETIC_CALLER_PACKAGE};
+        ExternalKeyCaller caller = new ExternalKeyCaller(SYNTHETIC_CALLER_UID, packages);
+        Arrays.fill(packages, SYNTHETIC_CALLER_PACKAGE);
+
+        String[] observedPackages = caller.copyPackageNames();
+        assertThat(observedPackages)
+                .asList()
+                .containsExactly(SYNTHETIC_CALLER_PACKAGE, ALTERNATE_CALLER_PACKAGE)
+                .inOrder();
+        Arrays.fill(observedPackages, SYNTHETIC_CALLER_PACKAGE);
+        assertThat(caller.copyPackageNames())
+                .asList()
+                .containsExactly(SYNTHETIC_CALLER_PACKAGE, ALTERNATE_CALLER_PACKAGE)
+                .inOrder();
+        assertThat(caller.toString()).doesNotContain(SYNTHETIC_CALLER_PACKAGE);
+        assertThat(caller.toString()).doesNotContain(ALTERNATE_CALLER_PACKAGE);
+    }
+
+    @Test
+    public void p384EcdsaShapeRequiresCanonicalPositiveDerIntegers() {
+        byte[] canonical = syntheticP384EcdsaSignature();
+        assertThat(ExternalKeyManager.isCanonicalP384EcdsaSignature(canonical)).isTrue();
+
+        byte[] negative = canonical.clone();
+        negative[firstScalarOffset()] = (byte) DER_SIGN_BIT_MASK;
+        assertThat(ExternalKeyManager.isCanonicalP384EcdsaSignature(negative)).isFalse();
+
+        byte[] longForm = canonical.clone();
+        longForm[DER_TAG_LENGTH_BYTES] = (byte) DER_SHORT_FORM_LIMIT;
+        assertThat(ExternalKeyManager.isCanonicalP384EcdsaSignature(longForm)).isFalse();
+
+        byte[] trailing = Arrays.copyOf(canonical, canonical.length + EXTRA_TRAILING_LENGTH_BYTES);
+        assertThat(ExternalKeyManager.isCanonicalP384EcdsaSignature(trailing)).isFalse();
+    }
+
+    private static ExternalKeyCaller syntheticCaller() {
+        return new ExternalKeyCaller(SYNTHETIC_CALLER_UID, new String[] {SYNTHETIC_CALLER_PACKAGE});
+    }
+
+    private static KeyChainExternalSignatureRequest newRequest(
+            long generation, @KeyChainExternalSignatureRequest.SignatureAlgorithm int algorithm) {
+        byte[] digest = new byte[KeyChainExternalSignatureRequest.getDigestLengthBytes(algorithm)];
+        Arrays.fill(digest, SYNTHETIC_DIGEST_FILL);
+        try {
+            return KeyChainExternalSignatureRequest.create(
+                    ExternalKeyManager.KEYCHAIN_ALIAS, algorithm, digest, generation);
+        } finally {
+            Arrays.fill(digest, CLEARED_BYTE);
+        }
+    }
+
+    private static PrivateKeyEntry syntheticRsaKeyEntry() {
+        return TestKeyStore.getClientCertificate()
+                .getPrivateKey(KeyProperties.KEY_ALGORITHM_RSA, KeyProperties.KEY_ALGORITHM_RSA);
+    }
+
+    private static ExternalKeyIdentity syntheticRsaIdentity() throws CertificateException {
+        PrivateKeyEntry keyEntry = syntheticRsaKeyEntry();
+        try {
+            return ExternalKeyIdentity.create(
+                    keyEntry.getCertificate().getEncoded(),
+                    encodeCaCertificates(keyEntry.getCertificateChain()),
+                    SYNTHETIC_PROVIDER_GENERATION);
+        } catch (CertificateEncodingException exception) {
+            throw new CertificateException(
+                    "Synthetic leaf certificate cannot be encoded", exception);
+        }
+    }
+
+    private static void assertIdentityRejected(byte[] leaf, byte[] chain, long providerGeneration) {
+        try {
+            ExternalKeyIdentity.create(leaf, chain, providerGeneration);
+            throw new AssertionError("Malformed external identity was accepted");
+        } catch (CertificateException | IllegalArgumentException expected) {
+            // Exact parse details do not cross the provider boundary.
+        }
+    }
+
+    private static byte[] encodeCaCertificates(Certificate[] chain)
+            throws CertificateEncodingException {
+        if (chain.length <= FIRST_CA_CERTIFICATE_INDEX) {
+            return null;
+        }
+        ByteArrayOutputStream encoded = new ByteArrayOutputStream();
+        for (int index = FIRST_CA_CERTIFICATE_INDEX; index < chain.length; index++) {
+            byte[] certificate = chain[index].getEncoded();
+            encoded.write(certificate, FIRST_ARRAY_OFFSET, certificate.length);
+        }
+        return encoded.toByteArray();
+    }
+
+    private static byte[] syntheticRsaSignature(ExternalKeyIdentity identity) {
+        byte[] signature = new byte[syntheticRsaSignatureLength(identity)];
+        Arrays.fill(signature, SYNTHETIC_SIGNATURE_FILL);
+        return signature;
+    }
+
+    private static int syntheticRsaSignatureLength(ExternalKeyIdentity identity) {
+        int modulusLengthBits = ((RSAKey) identity.getPublicKey()).getModulus().bitLength();
+        return (modulusLengthBits + RSA_SIGNATURE_LENGTH_ROUNDING_BITS) / Byte.SIZE;
+    }
+
+    private static byte[] syntheticP384EcdsaSignature() {
+        byte[] scalar = new byte[P384_SCALAR_LENGTH_BYTES];
+        Arrays.fill(scalar, SYNTHETIC_SCALAR_FILL);
+        int integerLength = DER_HEADER_LENGTH_BYTES + scalar.length;
+        int sequenceLength = integerLength + integerLength;
+        ByteArrayOutputStream encoded = new ByteArrayOutputStream();
+        encoded.write(DER_SEQUENCE_TAG);
+        encoded.write(sequenceLength);
+        writeDerInteger(encoded, scalar);
+        writeDerInteger(encoded, scalar);
+        Arrays.fill(scalar, CLEARED_BYTE);
+        return encoded.toByteArray();
+    }
+
+    private static void writeDerInteger(ByteArrayOutputStream destination, byte[] scalar) {
+        destination.write(DER_INTEGER_TAG);
+        destination.write(scalar.length);
+        destination.write(scalar, FIRST_ARRAY_OFFSET, scalar.length);
+    }
+
+    private static int firstScalarOffset() {
+        return DER_FIRST_VALUE_OFFSET + DER_HEADER_LENGTH_BYTES;
+    }
+
+    private static final class FakeProvider implements ExternalKeyProvider {
+        private ExternalKeyIdentity mIdentity;
+        private KeyChainExternalSignatureResult mNextResult;
+        private ExternalKeyCaller mObservedCaller;
+        private int mSignCallCount;
+        private long mRemovedGeneration;
+        private boolean mThrowDuringSign;
+        private boolean mThrowAssertionDuringSign;
+
+        FakeProvider(ExternalKeyIdentity identity) {
+            mIdentity = identity;
+        }
+
+        @Override
+        public ExternalKeyIdentity getActiveIdentity() {
+            return mIdentity;
+        }
+
+        @Override
+        public KeyChainExternalSignatureResult sign(
+                ExternalKeyCaller caller, KeyChainExternalSignatureRequest request) {
+            mSignCallCount++;
+            mObservedCaller = caller;
+            if (mThrowDuringSign) {
+                throw new IllegalStateException("synthetic provider failure");
+            }
+            if (mThrowAssertionDuringSign) {
+                throw new AssertionError("synthetic provider assertion");
+            }
+            KeyChainExternalSignatureResult result = mNextResult;
+            mNextResult = null;
+            return result;
+        }
+
+        @Override
+        public boolean removeIdentity(long providerGeneration) {
+            if (mIdentity == null || mIdentity.getProviderGeneration() != providerGeneration) {
+                return false;
+            }
+            mRemovedGeneration = providerGeneration;
+            mIdentity = null;
+            return true;
+        }
+
+        @Override
+        public void close() {
+            mIdentity = null;
+            if (mNextResult != null) {
+                mNextResult.close();
+                mNextResult = null;
+            }
+        }
+    }
+}
