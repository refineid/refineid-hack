+package com.android.keychain;
+
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.security.KeyChainExternalSignatureRequest;
+import android.security.KeyChainExternalSignatureResult;
+
+/** Trusted source of the active external identity and its exact-digest operation. */
+interface ExternalKeyProvider extends AutoCloseable {
+    /** Returns one immutable identity snapshot, or {@code null} while no identity is active. */
+    @Nullable
+    ExternalKeyIdentity getActiveIdentity();
+
+    /** Signs after KeyChain has authenticated the Binder caller and checked its alias grant. */
+    @NonNull
+    KeyChainExternalSignatureResult sign(
+            @NonNull ExternalKeyCaller caller, @NonNull KeyChainExternalSignatureRequest request);
+
+    /** Removes the exact active generation and makes it unavailable for later queries. */
+    boolean removeIdentity(long providerGeneration);
+
+    /** Releases a binding and rejects subsequent operations. */
+    @Override
+    void close();
+}
