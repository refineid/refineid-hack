+                                        .SIGNATURE_ALGORITHM_ECDSA_P384_SHA256);
+                KeyChainExternalSignatureResult wrongKeyResult =
+                        manager.sign(syntheticCaller(), wrongKeyRequest)) {
+            assertThat(wrongKeyResult.getFailure())
+                    .isEqualTo(KeyChainExternalSignatureResult.FAILURE_INVALID_REQUEST);
+        }
