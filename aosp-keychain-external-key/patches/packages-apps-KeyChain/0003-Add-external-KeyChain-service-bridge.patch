+
+package com.android.keychain;
+
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.security.KeyChainExternalSignatureRequest;
+import android.security.KeyChainExternalSignatureResult;
+import android.security.KeyChainPrivateKeyDescriptor;
+import android.security.keystore.KeyProperties;
+
+import java.security.PublicKey;
+import java.security.interfaces.RSAKey;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import java.util.Objects;
+
+/** KeyChain-owned namespace, validation, and failure boundary for one trusted provider. */
+final class ExternalKeyManager {
+    static final String KEYCHAIN_ALIAS = "refineid-client-authentication";
+
+    private static final int DER_SEQUENCE_TAG = 0x30;
+    private static final int DER_INTEGER_TAG = 0x02;
+    private static final int DER_SHORT_FORM_LIMIT = 0x80;
+    private static final int DER_SIGN_BIT_MASK = 0x80;
+    private static final int DER_UNSIGNED_PADDING = 0x00;
+    private static final int UNSIGNED_BYTE_MASK = 0xFF;
+    private static final int P384_SCALAR_LENGTH_BITS = 384;
+    private static final int P384_SCALAR_LENGTH_BYTES = P384_SCALAR_LENGTH_BITS / Byte.SIZE;
+    private static final int DER_POSITIVE_PADDING_LENGTH_BYTES = 1;
+    private static final int MAXIMUM_DER_INTEGER_LENGTH_BYTES =
+            P384_SCALAR_LENGTH_BYTES + DER_POSITIVE_PADDING_LENGTH_BYTES;
+    private static final int FIRST_DER_OFFSET = 0;
+    private static final int DER_TAG_LENGTH_BYTES = 1;
+    private static final int NO_REMAINING_BYTES = 0;
+    private static final int NO_MASKED_BITS = 0;
+    private static final int BITS_TO_BYTES_ROUNDING_OFFSET = Byte.SIZE - 1;
+    private static final byte CLEARED_BYTE = 0;
+
+    private final @NonNull ExternalKeyProvider mProvider;
+    private volatile boolean mClosed;
+
+    ExternalKeyManager(@NonNull ExternalKeyProvider provider) {
+        mProvider = Objects.requireNonNull(provider);
+    }
+
+    @NonNull
+    static ExternalKeyManager unavailable() {
+        return new ExternalKeyManager(new UnavailableProvider());
+    }
+
+    static boolean isExternalAlias(@Nullable String alias) {
+        return KEYCHAIN_ALIAS.equals(alias);
+    }
+
+    @NonNull
+    List<String> getActiveAliases() {
+        return getActiveIdentity() == null
+                ? Collections.emptyList()
+                : Collections.singletonList(KEYCHAIN_ALIAS);
+    }
+
+    boolean containsActiveAlias(@Nullable String alias) {
+        return isExternalAlias(alias) && getActiveIdentity() != null;
+    }
+
+    @Nullable
+    KeyChainPrivateKeyDescriptor getPrivateKeyDescriptor(@Nullable String alias) {
+        ExternalKeyIdentity identity = getIdentityForAlias(alias);
+        if (identity == null) {
+            return null;
+        }
+        return KeyChainPrivateKeyDescriptor.forExternalKey(
+                KEYCHAIN_ALIAS,
+                identity.getKeyAlgorithm(),
+                identity.copyEncodedPublicKey(),
+                identity.getProviderGeneration());
+    }
+
+    @Nullable
+    byte[] getCertificate(@Nullable String alias) {
+        ExternalKeyIdentity identity = getIdentityForAlias(alias);
+        return identity == null ? null : identity.copyLeafCertificate();
+    }
+
+    @Nullable
+    byte[] getCaCertificates(@Nullable String alias) {
+        ExternalKeyIdentity identity = getIdentityForAlias(alias);
+        return identity == null ? null : identity.copyCaCertificates();
+    }
+
+    @NonNull
+    KeyChainExternalSignatureResult sign(
+            @NonNull ExternalKeyCaller caller, @NonNull KeyChainExternalSignatureRequest request) {
+        Objects.requireNonNull(caller);
+        Objects.requireNonNull(request);
+
+        if (!isExternalAlias(request.getExternalAlias()) || !isOpen(request)) {
+            return failure(KeyChainExternalSignatureResult.FAILURE_INVALID_REQUEST);
+        }
+        ExternalKeyIdentity identity = getActiveIdentity();
+        if (identity == null) {
+            return failure(KeyChainExternalSignatureResult.FAILURE_PROVIDER_UNAVAILABLE);
+        }
+        if (request.getProviderGeneration() != identity.getProviderGeneration()) {
+            return failure(KeyChainExternalSignatureResult.FAILURE_PROVIDER_GENERATION_CHANGED);
+        }
+        if (!identity.getKeyAlgorithm()
+                .equals(KeyChainExternalSignatureRequest.getKeyAlgorithm(request.getAlgorithm()))) {
+            return failure(KeyChainExternalSignatureResult.FAILURE_INVALID_REQUEST);
+        }
+        if (Thread.currentThread().isInterrupted()) {
+            return failure(KeyChainExternalSignatureResult.FAILURE_CALLER_INTERRUPTED);
+        }
+
+        try {
+            KeyChainExternalSignatureResult providerResult = mProvider.sign(caller, request);
+            if (providerResult == null) {
+                return failure(KeyChainExternalSignatureResult.FAILURE_INTERNAL_ERROR);
+            }
+            try (KeyChainExternalSignatureResult ownedProviderResult = providerResult) {
+                if (!ownedProviderResult.isSuccess()) {
+                    return failure(ownedProviderResult.getFailure());
+                }
+                byte[] signature = ownedProviderResult.copySignature();
+                try {
+                    if (!hasValidSignatureShape(identity, signature)) {
+                        return failure(KeyChainExternalSignatureResult.FAILURE_SIGNING_FAILED);
+                    }
+                    return KeyChainExternalSignatureResult.success(signature);
+                } finally {
+                    Arrays.fill(signature, CLEARED_BYTE);
+                }
+            }
+        } catch (RuntimeException | AssertionError exception) {
+            return failure(KeyChainExternalSignatureResult.FAILURE_INTERNAL_ERROR);
+        }
+    }
+
+    boolean removeActiveIdentity(@Nullable String alias) {
+        ExternalKeyIdentity identity = getIdentityForAlias(alias);
+        if (identity == null) {
+            return false;
+        }
+        long removedGeneration = identity.getProviderGeneration();
+        try {
+            if (!mProvider.removeIdentity(removedGeneration)) {
+                return false;
+            }
+        } catch (RuntimeException | AssertionError exception) {
+            return false;
+        }
+        ExternalKeyIdentity currentIdentity = getActiveIdentity();
+        return currentIdentity == null
+                || currentIdentity.getProviderGeneration() != removedGeneration;
+    }
+
+    synchronized void close() {
+        if (mClosed) {
+            return;
+        }
+        mClosed = true;
+        try {
+            mProvider.close();
+        } catch (RuntimeException | AssertionError exception) {
+            // Service shutdown is already fail-closed.
+        }
+    }
+
+    @Nullable
+    private ExternalKeyIdentity getIdentityForAlias(@Nullable String alias) {
+        return isExternalAlias(alias) ? getActiveIdentity() : null;
+    }
+
+    @Nullable
+    private ExternalKeyIdentity getActiveIdentity() {
+        if (mClosed) {
+            return null;
+        }
+        try {
+            return mProvider.getActiveIdentity();
+        } catch (RuntimeException | AssertionError exception) {
+            return null;
+        }
+    }
+
+    private static boolean isOpen(@NonNull KeyChainExternalSignatureRequest request) {
+        byte[] digest = null;
+        try {
+            digest = request.copyDigest();
+            return true;
+        } catch (IllegalStateException exception) {
+            return false;
+        } finally {
+            if (digest != null) {
+                Arrays.fill(digest, CLEARED_BYTE);
+            }
+        }
+    }
+
+    private static boolean hasValidSignatureShape(
+            @NonNull ExternalKeyIdentity identity, @NonNull byte[] signature) {
+        switch (identity.getKeyAlgorithm()) {
+            case KeyProperties.KEY_ALGORITHM_RSA:
+                PublicKey publicKey = identity.getPublicKey();
+                if (!(publicKey instanceof RSAKey)) {
+                    return false;
+                }
+                int modulusLengthBits = ((RSAKey) publicKey).getModulus().bitLength();
+                int modulusLengthBytes =
+                        (modulusLengthBits + BITS_TO_BYTES_ROUNDING_OFFSET) / Byte.SIZE;
+                return signature.length == modulusLengthBytes;
+            case KeyProperties.KEY_ALGORITHM_EC:
+                return isCanonicalP384EcdsaSignature(signature);
+            default:
+                return false;
+        }
+    }
+
+    static boolean isCanonicalP384EcdsaSignature(@NonNull byte[] signature) {
+        try {
+            int offset = FIRST_DER_OFFSET;
+            offset = requireDerValue(signature, offset, DER_SEQUENCE_TAG);
+            int sequenceLength = requireDerShortLength(signature, offset);
+            offset++;
+            if (sequenceLength != signature.length - offset) {
+                return false;
+            }
+            offset = requireDerInteger(signature, offset);
+            offset = requireDerInteger(signature, offset);
+            return signature.length - offset == NO_REMAINING_BYTES;
+        } catch (IllegalArgumentException exception) {
+            return false;
+        }
+    }
+
+    private static int requireDerInteger(@NonNull byte[] encoded, int offset) {
+        offset = requireDerValue(encoded, offset, DER_INTEGER_TAG);
+        int integerLength = requireDerShortLength(encoded, offset);
+        offset++;
+        if (integerLength < DER_POSITIVE_PADDING_LENGTH_BYTES
+                || integerLength > MAXIMUM_DER_INTEGER_LENGTH_BYTES
+                || integerLength > encoded.length - offset) {
+            throw new IllegalArgumentException("Malformed external ECDSA integer length");
+        }
+
+        int first = encoded[offset] & UNSIGNED_BYTE_MASK;
+        int magnitudeOffset = offset;
+        int magnitudeLength = integerLength;
+        if (first == DER_UNSIGNED_PADDING) {
+            if (integerLength == DER_POSITIVE_PADDING_LENGTH_BYTES) {
+                throw new IllegalArgumentException("External ECDSA integer is zero");
+            }
+            int next = encoded[offset + DER_POSITIVE_PADDING_LENGTH_BYTES] & UNSIGNED_BYTE_MASK;
+            if ((next & DER_SIGN_BIT_MASK) == NO_MASKED_BITS) {
+                throw new IllegalArgumentException("External ECDSA integer has redundant padding");
+            }
+            magnitudeOffset++;
+            magnitudeLength--;
+        } else if ((first & DER_SIGN_BIT_MASK) != NO_MASKED_BITS) {
+            throw new IllegalArgumentException("External ECDSA integer is negative");
+        }
+        if (magnitudeLength > P384_SCALAR_LENGTH_BYTES
+                || isAllZero(encoded, magnitudeOffset, magnitudeLength)) {
+            throw new IllegalArgumentException("External ECDSA integer is out of range");
+        }
+        return offset + integerLength;
+    }
+
+    private static int requireDerValue(@NonNull byte[] encoded, int offset, int expectedTag) {
+        if (offset >= encoded.length || (encoded[offset] & UNSIGNED_BYTE_MASK) != expectedTag) {
+            throw new IllegalArgumentException("Malformed external ECDSA signature");
+        }
+        return offset + DER_TAG_LENGTH_BYTES;
+    }
+
+    private static int requireDerShortLength(@NonNull byte[] encoded, int offset) {
+        if (offset >= encoded.length) {
+            throw new IllegalArgumentException("Missing external ECDSA length");
+        }
+        int length = encoded[offset] & UNSIGNED_BYTE_MASK;
+        if (length >= DER_SHORT_FORM_LIMIT) {
+            throw new IllegalArgumentException("External ECDSA length is not canonical");
+        }
+        return length;
+    }
+
+    private static boolean isAllZero(@NonNull byte[] value, int offset, int length) {
+        int end = offset + length;
+        for (int index = offset; index < end; index++) {
+            if (value[index] != CLEARED_BYTE) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    @NonNull
+    private static KeyChainExternalSignatureResult failure(
+            @KeyChainExternalSignatureResult.Failure int failure) {
+        return KeyChainExternalSignatureResult.failure(failure);
+    }
+
+    private static final class UnavailableProvider implements ExternalKeyProvider {
+        @Override
+        @Nullable
+        public ExternalKeyIdentity getActiveIdentity() {
+            return null;
+        }
+
+        @Override
+        @NonNull
+        public KeyChainExternalSignatureResult sign(
+                @NonNull ExternalKeyCaller caller,
+                @NonNull KeyChainExternalSignatureRequest request) {
+            return failure(KeyChainExternalSignatureResult.FAILURE_PROVIDER_UNAVAILABLE);
+        }
+
+        @Override
+        public boolean removeIdentity(long providerGeneration) {
+            return false;
+        }
+
+        @Override
+        public void close() {}
+    }
+}
