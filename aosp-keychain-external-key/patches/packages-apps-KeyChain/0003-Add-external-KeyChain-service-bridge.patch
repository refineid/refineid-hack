+public final class ExternalKeyManagerTest {
+    private static final long SYNTHETIC_PROVIDER_GENERATION = 7L;
+    private static final long STALE_PROVIDER_GENERATION = 6L;
+    private static final int SYNTHETIC_CALLER_UID = 12_345;
+    private static final String SYNTHETIC_CALLER_PACKAGE = "com.example.browser";
+    private static final String ALTERNATE_CALLER_PACKAGE = "com.example.browser.helper";
+    private static final byte SYNTHETIC_DIGEST_FILL = 0x5A;
+    private static final byte SYNTHETIC_SIGNATURE_FILL = 0x35;
+    private static final byte SYNTHETIC_SCALAR_FILL = 0x31;
+    private static final byte CLEARED_BYTE = 0;
+    private static final int LEAF_CERTIFICATE_INDEX = 0;
+    private static final int FIRST_CA_CERTIFICATE_INDEX = LEAF_CERTIFICATE_INDEX + 1;
+    private static final int P384_SCALAR_LENGTH_BITS = 384;
+    private static final int P384_SCALAR_LENGTH_BYTES = P384_SCALAR_LENGTH_BITS / Byte.SIZE;
+    private static final int DER_SEQUENCE_TAG = 0x30;
+    private static final int DER_INTEGER_TAG = 0x02;
+    private static final int DER_TAG_LENGTH_BYTES = 1;
+    private static final int DER_LENGTH_LENGTH_BYTES = 1;
+    private static final int DER_HEADER_LENGTH_BYTES =
+            DER_TAG_LENGTH_BYTES + DER_LENGTH_LENGTH_BYTES;
+    private static final int DER_FIRST_VALUE_OFFSET = DER_HEADER_LENGTH_BYTES;
+    private static final int DER_SHORT_FORM_LIMIT = 0x80;
+    private static final int DER_SIGN_BIT_MASK = 0x80;
+    private static final int EXTRA_TRAILING_LENGTH_BYTES = 1;
+    private static final int RSA_SIGNATURE_LENGTH_ROUNDING_BITS = Byte.SIZE - 1;
+    private static final int NO_SIGN_CALLS = 0;
+    private static final int FIRST_ARRAY_OFFSET = 0;
+    private static final long NO_PROVIDER_GENERATION = 0L;
+    private static final int TRUNCATED_CERTIFICATE_LENGTH_BYTES = 1;
+    private static final byte MALFORMED_CERTIFICATE_BYTE = 0x31;
+
+    @Test
+    public void identityDerivesItsKeyAndDefensivelyCopiesCertificates() throws Exception {
+        PrivateKeyEntry keyEntry = syntheticRsaKeyEntry();
+        byte[] leaf = keyEntry.getCertificate().getEncoded();
+        byte[] chain = encodeCaCertificates(keyEntry.getCertificateChain());
+
+        ExternalKeyIdentity identity =
+                ExternalKeyIdentity.create(leaf, chain, SYNTHETIC_PROVIDER_GENERATION);
+        Arrays.fill(leaf, CLEARED_BYTE);
+        if (chain != null) {
+            Arrays.fill(chain, CLEARED_BYTE);
+        }
+
+        assertThat(identity.getKeyAlgorithm()).isEqualTo(KeyProperties.KEY_ALGORITHM_RSA);
+        assertThat(identity.getProviderGeneration()).isEqualTo(SYNTHETIC_PROVIDER_GENERATION);
+        assertThat(identity.copyLeafCertificate())
+                .isEqualTo(keyEntry.getCertificate().getEncoded());
+        assertThat(identity.copyEncodedPublicKey())
+                .isEqualTo(keyEntry.getCertificate().getPublicKey().getEncoded());
+        assertThat(identity.toString()).doesNotContain("subject");
+    }
+
+    @Test
+    public void identityRejectsMalformedCertificatesAndNonpositiveGeneration() throws Exception {
+        PrivateKeyEntry keyEntry = syntheticRsaKeyEntry();
+        byte[] leaf = keyEntry.getCertificate().getEncoded();
+        byte[] truncated = Arrays.copyOf(leaf, leaf.length - TRUNCATED_CERTIFICATE_LENGTH_BYTES);
+        byte[] malformed = {MALFORMED_CERTIFICATE_BYTE};
+
+        assertIdentityRejected(truncated, null, SYNTHETIC_PROVIDER_GENERATION);
+        assertIdentityRejected(malformed, null, SYNTHETIC_PROVIDER_GENERATION);
+        assertIdentityRejected(leaf, malformed, SYNTHETIC_PROVIDER_GENERATION);
+        assertIdentityRejected(leaf, null, NO_PROVIDER_GENERATION);
+    }
+
+    @Test
+    public void unavailableProviderPublishesNothingAndFailsClosed() throws Exception {
+        ExternalKeyManager manager = ExternalKeyManager.unavailable();
+
+        assertThat(manager.getActiveAliases()).isEmpty();
+        assertThat(manager.getPrivateKeyDescriptor(ExternalKeyManager.KEYCHAIN_ALIAS)).isNull();
+        try (KeyChainExternalSignatureRequest request =
+                        newRequest(
+                                SYNTHETIC_PROVIDER_GENERATION,
+                                KeyChainExternalSignatureRequest
+                                        .SIGNATURE_ALGORITHM_RSA_PKCS1_SHA256);
+                KeyChainExternalSignatureResult result = manager.sign(syntheticCaller(), request)) {
+            assertThat(result.getFailure())
+                    .isEqualTo(KeyChainExternalSignatureResult.FAILURE_PROVIDER_UNAVAILABLE);
+        } finally {
+            manager.close();
+        }
+    }
+
+    @Test
+    public void descriptorAndCertificatesUseOneValidatedSnapshot() throws Exception {
+        ExternalKeyIdentity identity = syntheticRsaIdentity();
+        FakeProvider provider = new FakeProvider(identity);
+        ExternalKeyManager manager = new ExternalKeyManager(provider);
+
+        KeyChainPrivateKeyDescriptor descriptor =
+                manager.getPrivateKeyDescriptor(ExternalKeyManager.KEYCHAIN_ALIAS);
+
+        assertThat(descriptor).isNotNull();
+        assertThat(descriptor.getType()).isEqualTo(KeyChainPrivateKeyDescriptor.TYPE_EXTERNAL_KEY);
+        assertThat(descriptor.getExternalAlias()).isEqualTo(ExternalKeyManager.KEYCHAIN_ALIAS);
+        assertThat(descriptor.getAlgorithm()).isEqualTo(identity.getKeyAlgorithm());
+        assertThat(descriptor.getEncodedPublicKey()).isEqualTo(identity.copyEncodedPublicKey());
+        assertThat(descriptor.getProviderGeneration()).isEqualTo(SYNTHETIC_PROVIDER_GENERATION);
+        assertThat(manager.getCertificate(ExternalKeyManager.KEYCHAIN_ALIAS))
+                .isEqualTo(identity.copyLeafCertificate());
+        assertThat(manager.getCaCertificates(ExternalKeyManager.KEYCHAIN_ALIAS))
+                .isEqualTo(identity.copyCaCertificates());
+    }
+
+    @Test
+    public void generationAndKeyAlgorithmAreCheckedBeforeProviderCall() throws Exception {
+        FakeProvider provider = new FakeProvider(syntheticRsaIdentity());
+        ExternalKeyManager manager = new ExternalKeyManager(provider);
+
+        try (KeyChainExternalSignatureRequest staleRequest =
+                        newRequest(
+                                STALE_PROVIDER_GENERATION,
