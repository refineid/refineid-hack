+        assertThat(provider.mSignCallCount).isEqualTo(NO_SIGN_CALLS);
+    }
+
+    @Test
+    public void closedAndInterruptedRequestsNeverReachProvider() throws Exception {
+        FakeProvider provider = new FakeProvider(syntheticRsaIdentity());
+        ExternalKeyManager manager = new ExternalKeyManager(provider);
+        KeyChainExternalSignatureRequest closedRequest =
+                newRequest(
