+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.keychain;
+
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.security.keystore.KeyProperties;
+
+import java.io.ByteArrayInputStream;
+import java.security.PublicKey;
+import java.security.cert.Certificate;
+import java.security.cert.CertificateEncodingException;
+import java.security.cert.CertificateException;
+import java.security.cert.CertificateFactory;
+import java.security.cert.X509Certificate;
+import java.security.interfaces.ECPublicKey;
+import java.security.interfaces.RSAKey;
+import java.security.spec.ECParameterSpec;
+import java.util.Collection;
+import java.util.Objects;
+
+/** One validated snapshot of the active external client-authentication identity. */
+final class ExternalKeyIdentity {
+    private static final int MINIMUM_CERTIFICATE_LENGTH_BYTES = 1;
+    private static final int MINIMUM_PUBLIC_KEY_LENGTH_BYTES = 1;
+    private static final int P384_KEY_SIZE_BITS = 384;
+    private static final int NO_REMAINING_BYTES = 0;
+    private static final int NO_CA_CERTIFICATE_LENGTH_BYTES = 0;
+    private static final long FIRST_PROVIDER_GENERATION = 1L;
+
+    private final @NonNull byte[] mLeafCertificate;
+    private final @Nullable byte[] mCaCertificates;
+    private final @NonNull String mKeyAlgorithm;
+    private final @NonNull byte[] mEncodedPublicKey;
+    private final @NonNull PublicKey mPublicKey;
+    private final long mProviderGeneration;
+
+    private ExternalKeyIdentity(
+            @NonNull byte[] leafCertificate,
+            @Nullable byte[] caCertificates,
+            @NonNull String keyAlgorithm,
+            @NonNull byte[] encodedPublicKey,
+            @NonNull PublicKey publicKey,
+            long providerGeneration) {
+        mLeafCertificate = leafCertificate;
+        mCaCertificates = caCertificates;
+        mKeyAlgorithm = keyAlgorithm;
+        mEncodedPublicKey = encodedPublicKey;
+        mPublicKey = publicKey;
+        mProviderGeneration = providerGeneration;
+    }
+
+    @NonNull
+    static ExternalKeyIdentity create(
+            @NonNull byte[] leafCertificate,
+            @Nullable byte[] caCertificates,
+            long providerGeneration)
+            throws CertificateException {
+        Objects.requireNonNull(leafCertificate);
+        if (leafCertificate.length < MINIMUM_CERTIFICATE_LENGTH_BYTES) {
+            throw new CertificateException("External leaf certificate is empty");
+        }
+        if (providerGeneration < FIRST_PROVIDER_GENERATION) {
+            throw new IllegalArgumentException("External provider generation must be positive");
+        }
+
+        X509Certificate parsedLeaf = parseSingleCertificate(leafCertificate);
+        PublicKey publicKey = parsedLeaf.getPublicKey();
+        String keyAlgorithm = publicKey.getAlgorithm();
+        if (!KeyProperties.KEY_ALGORITHM_RSA.equals(keyAlgorithm)
+                && !KeyProperties.KEY_ALGORITHM_EC.equals(keyAlgorithm)) {
+            throw new CertificateException("External certificate uses an unsupported key");
+        }
+        if (KeyProperties.KEY_ALGORITHM_RSA.equals(keyAlgorithm)
+                && !(publicKey instanceof RSAKey)) {
+            throw new CertificateException("External RSA certificate has an invalid public key");
+        }
+        if (KeyProperties.KEY_ALGORITHM_EC.equals(keyAlgorithm)) {
+            if (!(publicKey instanceof ECPublicKey)) {
+                throw new CertificateException("External EC certificate has an invalid public key");
+            }
+            ECParameterSpec parameters = ((ECPublicKey) publicKey).getParams();
+            if (parameters == null
+                    || parameters.getCurve().getField().getFieldSize() != P384_KEY_SIZE_BITS) {
+                throw new CertificateException("External EC certificate is not P-384");
+            }
+        }
+        byte[] encodedPublicKey = publicKey.getEncoded();
+        if (encodedPublicKey == null || encodedPublicKey.length < MINIMUM_PUBLIC_KEY_LENGTH_BYTES) {
+            throw new CertificateException("External certificate has no encoded public key");
+        }
+
+        byte[] canonicalLeaf = encodeCertificate(parsedLeaf);
+        byte[] validatedCaCertificates = validateCaCertificates(caCertificates);
+        return new ExternalKeyIdentity(
+                canonicalLeaf,
+                validatedCaCertificates,
+                keyAlgorithm,
+                encodedPublicKey.clone(),
+                publicKey,
+                providerGeneration);
+    }
+
+    @NonNull
+    byte[] copyLeafCertificate() {
+        return mLeafCertificate.clone();
+    }
+
+    @Nullable
+    byte[] copyCaCertificates() {
+        return mCaCertificates == null ? null : mCaCertificates.clone();
+    }
+
+    @NonNull
+    String getKeyAlgorithm() {
+        return mKeyAlgorithm;
+    }
+
+    @NonNull
+    byte[] copyEncodedPublicKey() {
+        return mEncodedPublicKey.clone();
+    }
+
+    @NonNull
+    PublicKey getPublicKey() {
+        return mPublicKey;
+    }
+
+    long getProviderGeneration() {
+        return mProviderGeneration;
+    }
+
+    @Override
+    public String toString() {
+        return "ExternalKeyIdentity{"
+                + "algorithm="
+                + mKeyAlgorithm
+                + ", leafLength="
+                + mLeafCertificate.length
+                + ", chainLength="
+                + (mCaCertificates == null
+                        ? NO_CA_CERTIFICATE_LENGTH_BYTES
+                        : mCaCertificates.length)
+                + ", providerGeneration="
+                + mProviderGeneration
+                + '}';
+    }
+
+    @NonNull
+    private static X509Certificate parseSingleCertificate(@NonNull byte[] encoded)
+            throws CertificateException {
+        ByteArrayInputStream source = new ByteArrayInputStream(encoded);
+        Certificate certificate =
+                CertificateFactory.getInstance("X.509").generateCertificate(source);
+        if (!(certificate instanceof X509Certificate) || source.available() != NO_REMAINING_BYTES) {
+            throw new CertificateException("External leaf certificate is malformed");
+        }
+        return (X509Certificate) certificate;
+    }
+
+    @NonNull
+    private static byte[] encodeCertificate(@NonNull X509Certificate certificate)
+            throws CertificateException {
+        try {
+            return certificate.getEncoded();
+        } catch (CertificateEncodingException exception) {
+            throw new CertificateException(
+                    "External leaf certificate cannot be encoded", exception);
+        }
+    }
+
+    @Nullable
+    private static byte[] validateCaCertificates(@Nullable byte[] encoded)
+            throws CertificateException {
+        if (encoded == null) {
+            return null;
+        }
+        if (encoded.length < MINIMUM_CERTIFICATE_LENGTH_BYTES) {
+            throw new CertificateException("External CA certificate chain is empty");
+        }
+
+        ByteArrayInputStream source = new ByteArrayInputStream(encoded);
+        Collection<? extends Certificate> certificates =
+                CertificateFactory.getInstance("X.509").generateCertificates(source);
+        if (certificates.isEmpty() || source.available() != NO_REMAINING_BYTES) {
+            throw new CertificateException("External CA certificate chain is malformed");
+        }
+        for (Certificate certificate : certificates) {
+            if (!(certificate instanceof X509Certificate)) {
+                throw new CertificateException("External CA certificate is not X.509");
+            }
+        }
+        return encoded.clone();
+    }
+}
