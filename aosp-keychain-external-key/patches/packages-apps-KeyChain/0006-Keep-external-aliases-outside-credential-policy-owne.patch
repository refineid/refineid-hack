From 95ed134ca70bab8666b6ff9cce996bc3ea0ac0ef Mon Sep 17 00:00:00 2001
From: Petri Koistinen <petri.koistinen@refineid.fi>
Date: Sat, 15 Aug 2026 17:55:18 +0300
Subject: [PATCH] Keep external aliases outside credential policy ownership

---
 src/com/android/keychain/ExternalKeyManager.java      |  4 ++++
 src/com/android/keychain/KeyChainService.java         |  7 ++++---
 .../com/android/keychain/ExternalKeyManagerTest.java  | 11 +++++++++++
 3 files changed, 19 insertions(+), 3 deletions(-)

diff --git a/src/com/android/keychain/ExternalKeyManager.java b/src/com/android/keychain/ExternalKeyManager.java
index af4ac16..88b5f5c 100644
--- a/src/com/android/keychain/ExternalKeyManager.java
+++ b/src/com/android/keychain/ExternalKeyManager.java
@@ -68,6 +68,10 @@ final class ExternalKeyManager {
         return KEYCHAIN_ALIAS.equals(alias);
     }
 
+    static boolean isCredentialPolicyOwnedAlias(@Nullable String alias) {
+        return !isExternalAlias(alias);
+    }
+
     @NonNull
     List<String> getActiveAliases() {
         return getActiveIdentity() == null
diff --git a/src/com/android/keychain/KeyChainService.java b/src/com/android/keychain/KeyChainService.java
index 523db4e..a5a9110 100644
--- a/src/com/android/keychain/KeyChainService.java
+++ b/src/com/android/keychain/KeyChainService.java
@@ -1002,7 +1002,8 @@ public class KeyChainService extends IntentService {
             // Uninstall all certificates that are no longer included in the new
             // authentication policy
             for (String existingAlias : existingAliases) {
-                if (!newAliases.contains(existingAlias)) {
+                if (!newAliases.contains(existingAlias)
+                        && ExternalKeyManager.isCredentialPolicyOwnedAlias(existingAlias)) {
                     removeKeyPairInternal(existingAlias);
                 }
             }
@@ -1016,8 +1017,8 @@ public class KeyChainService extends IntentService {
             }
             // Check whether any of the aliases in the policy already exist
             for (String alias : authenticationPolicy.getAliases()) {
-                if (mExternalKeyManager.containsActiveAlias(alias)
-                        || requestPrivateKey(alias) != null) {
+                if (ExternalKeyManager.isCredentialPolicyOwnedAlias(alias)
+                        && requestPrivateKey(alias) != null) {
                     throw new IllegalArgumentException(String.format("The authentication policy "
                             + "contains an installed alias: %s", alias));
                 }
diff --git a/tests/src/com/android/keychain/ExternalKeyManagerTest.java b/tests/src/com/android/keychain/ExternalKeyManagerTest.java
index cc37498..230b078 100644
--- a/tests/src/com/android/keychain/ExternalKeyManagerTest.java
+++ b/tests/src/com/android/keychain/ExternalKeyManagerTest.java
@@ -65,6 +65,17 @@ public final class ExternalKeyManagerTest {
     private static final long NO_PROVIDER_GENERATION = 0L;
     private static final int TRUNCATED_CERTIFICATE_LENGTH_BYTES = 1;
     private static final byte MALFORMED_CERTIFICATE_BYTE = 0x31;
+    private static final String SYNTHETIC_KEYSTORE_ALIAS = "synthetic-keystore-alias";
+
+    @Test
+    public void credentialPolicyNeverOwnsTheExternalAlias() {
+        assertThat(
+                        ExternalKeyManager.isCredentialPolicyOwnedAlias(
+                                ExternalKeyManager.KEYCHAIN_ALIAS))
+                .isFalse();
+        assertThat(ExternalKeyManager.isCredentialPolicyOwnedAlias(SYNTHETIC_KEYSTORE_ALIAS))
+                .isTrue();
+    }
 
     @Test
     public void identityDerivesItsKeyAndDefensivelyCopiesCertificates() throws Exception {
